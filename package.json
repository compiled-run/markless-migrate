{
	"name": "@markless/migrate",
	"version": "0.0.0",
	"private": true,
	"description": "Move an app to Markless with your own coding agent, proven route by route",
	"license": "MIT",
	"type": "module",
	"bin": {
		"markless-migrate": "./src/cli.ts"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts test/e2e/*.test.ts",
		"test:unit": "node --test test/*.test.ts",
		"test:e2e": "node --test test/e2e/*.test.ts",
		"typecheck": "tsc --noEmit",
		"browsers": "playwright install chromium"
	},
	"devDependencies": {
		"@floating-ui/dom": "1.7.6",
		"@markless/compiler": "0.9.0",
		"@markless/router": "0.7.0",
		"@tanstack/form-core": "1.20.0",
		"@tanstack/table-core": "9.0.0",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.12.2",
		"@types/pngjs": "^6.0.5",
		"@vercel/routing-utils": "^6.6.0",
		"d3-shape": "3.2.0",
		"fast-check": "4.10.2",
		"shadcn": "4.22.1",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@internationalized/date": "3.12.3",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"axe-core": "4.14.0",
		"graphql": "^17.0.2",
		"lighthouse": "12.8.2",
		"parse5": "^7.3.0",
		"path-to-regexp": "6.3.0",
		"pixelmatch": "^8.0.0",
		"playwright": "^1.64.1",
		"pngjs": "^7.0.0",
		"tree-sitter-php": "^0.24.2",
		"tree-sitter-python": "^0.25.0",
		"tree-sitter-ruby": "^0.23.1",
		"web-tree-sitter": "^0.27.1",
		"yuku": "0.20.1",
		"yuku-css": "0.2.0",
		"yuku-tsrx": "0.1.4",
		"zod": "^4.6.7"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	]
}
