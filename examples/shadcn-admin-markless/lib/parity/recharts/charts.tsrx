// Parity port of recharts for the dashboard: the BarChart (overview.tsx) and AreaChart (analytics-chart.tsx)
// with exactly the props those files pass (XAxis dataKey name, stroke #888888, fontSize 12, no tick or axis
// lines; Bar radius [4, 4, 0, 0]; two monotone Areas). Generated by deploy/shadcn-admin/scripts/gen-charts.py.
// The data is drawn from Math.random in the browser, as the old modules did, and public/parity/recharts.js
// lays the chart out when the page loads. The analytics chart sits in a tab recharts has not mounted yet, so it
// carries none of ResponsiveContainer's inline styles until recharts.js first lays it out.

export function OverviewChart() @{
	<div class="recharts-responsive-container" style="width: 100%; height: 350px; min-width: 0px;" data-parity-chart="overview"><div style="width: 0px; overflow-x: visible;"><div width="0" height="350" class="recharts-wrapper" style="position: relative; cursor: default; width: 0px; height: 350px;"><svg role="application" tabindex="0" class="recharts-surface" width="0" height="350" viewBox="0 0 0 350" style="width: 100%; height: 100%; display: block;"><title></title><desc></desc><g tabindex="-1" class="recharts-zIndex-layer_-100"></g><g tabindex="-1" class="recharts-zIndex-layer_-50"></g><defs><clipPath id="recharts1-clip"><rect x="65" y="5" height="310" width="0" /></clipPath></defs><g tabindex="-1" class="recharts-zIndex-layer_100"></g><g tabindex="-1" class="recharts-zIndex-layer_200"></g><g tabindex="-1" class="recharts-zIndex-layer_300"><g class="recharts-layer recharts-bar fill-primary" id="recharts-bar-1"><g class="recharts-layer recharts-bar-rectangles"><g class="recharts-layer"><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Jan" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Feb" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Mar" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Apr" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="May" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Jun" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Jul" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Aug" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Sep" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Oct" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Nov" /></g></g><g class="recharts-layer recharts-bar-rectangle"><g class="recharts-layer recharts-inactive-bar"><path fill="currentColor" class="recharts-rectangle fill-primary" name="Dec" /></g></g></g></g></g></g><g tabindex="-1" class="recharts-zIndex-layer_400"></g><g tabindex="-1" class="recharts-zIndex-layer_500"><g class="recharts-layer recharts-cartesian-axis recharts-xAxis xAxis"><g class="recharts-cartesian-axis-ticks recharts-xAxis-ticks"><g class="recharts-cartesian-axis-tick-lines recharts-xAxis-tick-lines"><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g></g></g></g><g class="recharts-layer recharts-cartesian-axis recharts-yAxis yAxis"><g class="recharts-cartesian-axis-ticks recharts-yAxis-ticks"><g class="recharts-cartesian-axis-tick-lines recharts-yAxis-tick-lines"><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g><g class="recharts-layer recharts-cartesian-axis-tick"></g></g></g></g></g><g tabindex="-1" class="recharts-zIndex-layer_600"></g><g tabindex="-1" class="recharts-zIndex-layer_1000"></g><g tabindex="-1" class="recharts-zIndex-layer_1100"></g><g tabindex="-1" class="recharts-zIndex-layer_1200"></g><g tabindex="-1" class="recharts-zIndex-layer_2000"><g class="recharts-cartesian-axis-tick-labels recharts-xAxis-tick-labels"><g class="recharts-layer recharts-cartesian-axis-tick-label"><text stroke="none" font-size="12" height="30" orientation="bottom" class="recharts-text recharts-cartesian-axis-tick-value" text-anchor="middle" fill="#888888"><tspan dy="0.71em">Jan</tspan></text></g><g class="recharts-layer recharts-cartesian-axis-tick-label"><text stroke="none" font-size="12" height="30" orientation="bottom" class="recharts-text recharts-cartesian-axis-tick-value" text-anchor="middle" fill="#888888"><tspan dy="0.71em">Feb</tspan></text></g><g class="recharts-layer recharts-cartesian-axis-tick-label"><text stroke="none" font-size="12" height="30" orientation="bottom" class="recharts-text recharts-cartesian-axis-tick-value" text-anchor="middle" fill="#888888"><tspan dy="0.71em">Mar</tspan></text></g><g class="recharts-layer recharts-cartesian-axis-tick-label"><text stroke="none" font-size="1