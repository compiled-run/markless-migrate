export function AnalyticsChart() @{
	<div class="recharts-responsive-container" data-parity-chart="analytics" data-parity-height="300"><div><div width="0" height="300" class="recharts-wrapper"><svg role="application" tabindex="0" class="recharts-surface" width="0" height="300" viewBox="0 0 0 300"><title></title><desc></desc><g tabindex="-1" class="recharts-zIndex-layer_-100"></g><g tabindex="-1" class="recharts-zIndex-layer_-50"></g><defs><clipPath id="recharts2-clip"><rect x="65" y="5" height="260" width="0" /></clipPath></defs><g tabindex="-1" class="recharts-zIndex-layer_100"><g class="recharts-layer recharts-area text-primary"><g class="recharts-layer"><defs><clipPath id="animationClipPath-recharts-area-1"><rect x="65" y="0" width="0" height="266" /></clipPath></defs><g class="recharts-layer" clip-path="url(#animationClipPath-recharts-area-1)"><g class="recharts-layer"><path class="recharts-curve recharts-area-area" stroke-width="1" fill="currentColor" fill-opacity="0.15" height="260" stroke="none" id="recharts-area-1" /><path class="recharts-curve recharts-area-curve" stroke-width="1" fill="none" fill-opacity="0.15" height="260" stroke="currentColor" /></g></g></g></g><g class="recharts-layer recharts-area text-muted-foreground"><g class="recharts-layer"><defs><clipPath id="animationClipPath-recharts-area-2"><rect x="65" y="0" width="0" height="266" /></clipPath></defs><g class="recharts-layer" clip-path="url(#animationClipPath-recharts-area-2)"><g class="recharts-layer"><path class="recharts-curve recharts-area-area" stroke-width="1" fill="currentColor" fill-opacity="0.1" height="260" stroke="none" id="recharts-area-2" /><path class="recharts-curve recharts-area-curve" stroke-width="1" fill="none" fill-opacity="0.1" height="260" stroke="currentColor" /></g></g></g></g></g><g tabindex="-1" class="recharts-zIndex-layer_200"></g><g tabindex="-1" class="recharts-zIndex-layer_300"></g><g tabindex="-1" class="recharts-zIndex-layer_400"></g><g tabindex="-1" class="recharts-zIndex-layer_500"><g class="r