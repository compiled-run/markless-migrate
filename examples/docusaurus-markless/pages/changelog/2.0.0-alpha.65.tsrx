ener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/ayonious.png" alt="Nahiyan Kamal" /></a></div></div><div class="imageOnlyAuthorCol_uiac"><div class="avatar margin-bottom--sm"><a href="https://github.com/ayshiff" target="_blank" rel="noopener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/ayshiff.png" alt="Rémi Doreau" /></a></div></div><div class="imageOnlyAuthorCol_uiac"><div class="avatar margin-bottom--sm"><a href="https://github.com/edno" target="_blank" rel="noopener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/edno.png" alt="Grégory Heitz" /></a></div></div><div class="imageOnlyAuthorCol_uiac"><div class="avatar margin-bottom--sm"><a href="https://github.com/jeremyhager" target="_blank" rel="noopener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/jeremyhager.png" alt="Jeremy Hager" /></a></div></div><div class="imageOnlyAuthorCol_uiac"><div class="avatar margin-bottom--sm"><a href="https://github.com/JoelMarcey" target="_blank" rel="noopener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/JoelMarcey.png" alt="Joel Marcey" /></a></div></div><div class="imageOnlyAuthorCol_uiac"><div class="avatar margin-bottom--sm"><a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="avatar__photo-link avatar__photo"><img class="image_oRbT" src="https://github.com/lex111.png" alt="Alexey Pyltsyn" /></a></div></div><button class="clean-btn toggleButton_WvRg" type="button" aria-label="expand" data-mm-changelog-authors={"[{\"name\":\"Long Ho\",\"url\":\"https://github.com/longlho\",\"imageURL\":\"https://github.com/longlho.png\"},{\"name\":\"moonrailgun\",\"url\":\"https://github.com/moonrailgun\",\"imageURL\":\"https://github.com/moonrailgun.png\"},{\"name\":\"Muskan Kumar\",\"url\":\"https://github.com/muskanvk\",\"imageURL\":\"https://github.com/muskanvk.png\"},{\"name\":\"Sam Zhou\",\"url\":\"https://github.com/SamChou19815\",\"imageURL\":\"https://github.com/SamChou19815.png\"},{\"name\":\"Bartosz Kaszubowski\",\"url\":\"https://github.com/Simek\",\"imageURL\":\"https://github.com/Simek.png\"},{\"name\":\"Sébastien Lorber\",\"url\":\"https://github.com/slorber\",\"imageURL\":\"https://github.com/slorber.png\"},{\"name\":\"Tim Gates\",\"url\":\"https://github.com/timgates42\",\"imageURL\":\"https://github.com/timgates42.png\"},{\"name\":\"Yangshun Tay\",\"url\":\"https://github.com/yangshun\",\"imageURL\":\"https://github.com/yangshun.png\"}]"}><svg viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor"><path d="M476.612887 1009.12034L169.240699 695.380437a51.981345 51.981345 0 0 1 0-72.319045 49.382277 49.382277 0 0 1 70.824582 0l271.959897 277.645356 271.862433-277.645356a49.382277 49.382277 0 0 1 70.824582 0 51.981345 51.981345 0 0 1 0 72.319045l-307.307212 313.739903a49.447254 49.447254 0 0 1-70.792094 0z m307.274724-608.116755L511.99269 123.455693l-271.959897 277.645357a49.382277 49.382277 0 0 1-70.824582 0 51.981345 51.981345 0 0 1 0-72.319045L476.580399 15.042102a49.382277 49.382277 0 0 1 70.727117 0l307.372188 313.739903a51.981345 51.981345 0 0 1 0 72.319045 49.414766 49.414766 0 0 1-70.824582 0z"></path></svg></button></div></header><div id="__blog-post-container" class="markdown">{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="rocket-new-feature">🚀 New Feature<a href="#rocket-new-feature" class="hash-link" aria-label="Direct link to 🚀 New Feature" title="Direct link to 🚀 New Feature" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class=""><code>docusaurus</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3497" target="_blank" rel="noopener noreferrer" class="">#3497</a> feat(v2): env variable TERSER_PARALLEL to customize TerserPlugin.parallel (<a href="https://github.com/aeneasr" target="_blank" rel="noopener noreferrer" class="">@aeneasr</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3446" target="_blank" rel="noopener noreferrer" class="">#3446</a> feat(v2): new docusaurus clear command (<a href="https://github.com/abadon7" target="_blank" rel="noopener noreferrer" class="">@abadon7</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3485" target="_blank" rel="noopener noreferrer" class="">#3485</a> feat(v2): Add @theme-init components to user theme (<a href="https://github.com/edno" target="_blank" rel="noopener noreferrer" class="">@edno</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-plugin-content-blog</code>, <code>docusaurus-plugin-content-docs</code>, <code>docusaurus-plugin-content-pages</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3467" target="_blank" rel="noopener noreferrer" class="">#3467</a> feat(v2): add beforeDefaultRemarkPlugins/beforeDefaultRehypePlugins options to all md content plugins (<a href="https://github.com/ayshiff" target="_blank" rel="noopener noreferrer" class="">@ayshiff</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-init</code>, <code>docusaurus-theme-bootstrap</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3496" target="_blank" rel="noopener noreferrer" class="">#3496</a> feat(v2): migrate bootstrap components to ts (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-theme-classic</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3474" target="_blank" rel="noopener noreferrer" class="">#3474</a> feat(v2): allow to use array of files in customCss field (<a href="https://github.com/Simek" target="_blank" rel="noopener noreferrer" class="">@Simek</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-plugin-content-pages</code>, <code>docusaurus-theme-classic</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3457" target="_blank" rel="noopener noreferrer" class="">#3457</a> feat(v2): add optional custom wrapper class name for pages based on theme classic Layout (<a href="https://github.com/Simek" target="_blank" rel="noopener noreferrer" class="">@Simek</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}</ul>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="bug-bug-fix">🐛 Bug Fix<a href="#bug-bug-fix" class="hash-link" aria-label="Direct link to 🐛 Bug Fix" title="Direct link to 🐛 Bug Fix" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class="">{"Other\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3517" target="_blank" rel="noopener noreferrer" class="">#3517</a> fix(v1): v1 deploy preview should be available (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3498" target="_blank" rel="noopener noreferrer" class="">#3498</a> fix(v2): fixed props being passed to @svgr/webpack loader (<a href="https://github.com/anru" target="_blank" rel="noopener noreferrer" class="">@anru</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-theme-search-algolia</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3456" target="_blank" rel="noopener noreferrer" class="">#3456</a> fix(v2): use valid value for crossorigin attribute (<a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="">@lex111</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-utils</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3427" target="_blank" rel="noopener noreferrer" class="">#3427</a> fix(v2): normalizeUrl edge cases (<a href="https://github.com/ayshiff" target="_blank" rel="noopener noreferrer" class="">@ayshiff</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-theme-classic</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3472" target="_blank" rel="noopener noreferrer" class="">#3472</a> fix(v2): Show dropdown instead of a single button when there are two versions (<a href="https://github.com/SamChou19815" target="_blank" rel="noopener noreferrer" class="">@SamChou19815</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-plugin-content-docs</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3441" target="_blank" rel="noopener noreferrer" class="">#3441</a> fix(v2): fixing typo in error message (<a href="https://github.com/ayonious" target="_blank" rel="noopener noreferrer" class="">@ayonious</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}</ul>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="nail_care-polish">💅 Polish<a href="#nail_care-polish" class="hash-link" aria-label="Direct link to 💅 Polish" title="Direct link to 💅 Polish" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class=""><code>docusaurus-theme-classic</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3499" target="_blank" rel="noopener noreferrer" class="">#3499</a> chore(v2): upgrade Infima to 0.2.0-alpha.13 (<a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="">@lex111</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}</ul>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="memo-documentation">📝 Documentation<a href="#memo-documentation" class="hash-link" aria-label="Direct link to 📝 Documentation" title="Direct link to 📝 Documentation" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class=""><code>docusaurus</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3502" target="_blank" rel="noopener noreferrer" class="">#3502</a> docs(v2): add doc for wrapping theme components with @theme-original and @theme-init (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class="">{"Other\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3473" target="_blank" rel="noopener noreferrer" class="">#3473</a> misc: add License to the documentation (<a href="https://github.com/muskanvk" target="_blank" rel="noopener noreferrer" class="">@muskanvk</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3492" target="_blank" rel="noopener noreferrer" class="">#3492</a> docs(v2): Added drone.io publish docs #3491 (<a href="https://github.com/aakhtar3" target="_blank" rel="noopener noreferrer" class="">@aakhtar3</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3479" target="_blank" rel="noopener noreferrer" class="">#3479</a> docs(v2): remove redundant new line in code block (<a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="">@lex111</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3448" target="_blank" rel="noopener noreferrer" class="">#3448</a> chore(v2): fix theme classic navbar style docs (<a href="https://github.com/Simek" target="_blank" rel="noopener noreferrer" class="">@Simek</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}</ul>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="house-internal">🏠 Internal<a href="#house-internal" class="hash-link" aria-label="Direct link to 🏠 Internal" title="Direct link to 🏠 Internal" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class=""><code>docusaurus-1.x</code>, <code>docusaurus-migrate</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3504" target="_blank" rel="noopener noreferrer" class="">#3504</a> chore(v1): move v1 docs inside website-1.x (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class="">{"Other\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3506" target="_blank" rel="noopener noreferrer" class="">#3506</a> chore(v2): v2 website should make it easy to contribute to upstream docs (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3511" target="_blank" rel="noopener noreferrer" class="">#3511</a> misc: update CODEOWNERS (<a href="https://github.com/yangshun" target="_blank" rel="noopener noreferrer" class="">@yangshun</a>)</li>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3477" target="_blank" rel="noopener noreferrer" class="">#3477</a> chore(v2): remove alpha 58 doc (<a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="">@lex111</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}<li class=""><code>docusaurus-utils-validation</code>{"\n"}<ul>{"\n"}<li class=""><a href="https://github.com/facebook/docusaurus/pull/3453" target="_blank" rel="noopener noreferrer" class="">#3453</a> test(v2): add protocol relative uri validation test (<a href="https://github.com/moonrailgun" target="_blank" rel="noopener noreferrer" class="">@moonrailgun</a>)</li>{"\n"}</ul>{"\n"}</li>{"\n"}</ul>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="committers-18">Committers: 18<a href="#committers-18" class="hash-link" aria-label="Direct link to Committers: 18" title="Direct link to Committers: 18" translate="no">​</a></h2>{"\n"}<ul>{"\n"}<li class="">Alexey Pyltsyn (<a href="https://github.com/lex111" target="_blank" rel="noopener noreferrer" class="">@lex111</a>)</li>{"\n"}<li class="">Andrey Rublev (<a href="https://github.com/anru" target="_blank" rel="noopener noreferrer" class="">@anru</a>)</li>{"\n"}<li class="">Bartosz Kaszubowski (<a href="https://github.com/Simek" target="_blank" rel="noopener noreferrer" class="">@Simek</a>)</li>{"\n"}<li class="">Grégory Heitz (<a href="https://github.com/edno" target="_blank" rel="noopener noreferrer" class="">@edno</a>)</li>{"\n"}<li class="">Henry Vélez (<a href="https://github.com/abadon7" target="_blank" rel="noopener noreferrer" class="">@abadon7</a>)</li>{"\n"}<li class="">Jeremy Hager (<a href="https://github.com/jeremyhager" target="_blank" rel="noopener noreferrer" class="">@jeremyhager</a>)</li>{"\n"}<li class="">Joel Marcey (<a href="https://github.com/JoelMarcey" target="_blank" rel="noopener noreferrer" class="">@JoelMarcey</a>)</li>{"\n"}<li class="">Long Ho (<a href="https://github.com/longlho" target="_blank" rel="noopener noreferrer" class="">@longlho</a>)</li>{"\n"}<li class="">Muskan Kumar (<a href="https://github.com/muskanvk" target="_blank" rel="noopener noreferrer" class="">@muskanvk</a>)</li>{"\n"}<li class="">Nahiyan Kamal (<a href="https://github.com/ayonious" target="_blank" rel="noopener noreferrer" class="">@ayonious</a>)</li>{"\n"}<li class="">Rémi Doreau (<a href="https://github.com/ayshiff" target="_blank" rel="noopener noreferrer" class="">@ayshiff</a>)</li>{"\n"}<li class="">Sam Zhou (<a href="https://github.com/SamChou19815" target="_blank" rel="noopener noreferrer" class="">@SamChou19815</a>)</li>{"\n"}<li class="">Sébastien Lorber (<a href="https://github.com/slorber" target="_blank" rel="noopener noreferrer" class="">@slorber</a>)</li>{"\n"}<li class="">Tim Gates (<a href="https://github.com/timgates42" target="_blank" rel="noopener noreferrer" class="">@timgates42</a>)</li>{"\n"}<li class="">Yangshun Tay (<a href="https://github.com/yangshun" target="_blank" rel="noopener noreferrer" class="">@yangshun</a>)</li>{"\n"}<li class=""><a href="https://github.com/aakhtar3" target="_blank" rel="noopener noreferrer" class="">@aakhtar3</a></li>{"\n"}<li class="">hackerman (<a href="https://github.com/aeneasr" target="_blank" rel="noopener noreferrer" class="">@aeneasr</a>)</li>{"\n"}<li class="">moonrailgun (<a href="https://github.com/moonrailgun" target="_blank" rel="noopener noreferrer" class="">@moonrailgun</a>)</li>{"\n"}</ul></div></article><nav class="pagination-nav docusaurus-mt-lg" aria-label="Changelog item navigation"><a class="pagination-nav__link pagination-nav__link--prev" href="/changelog/2.0.0-alpha.66"><div class="pagination-nav__sublabel">Newer release</div><div class="pagination-nav__label">2.0.0-alpha.66</div></a><a class="pagination-nav__link pagination-nav__link--next" href="/changelog/2.0.0-alpha.64"><div class="pagination-nav__sublabel">Older release</div><div class="pagination-nav__label">2.0.0-alpha.64</div></a></nav></main><div class="col col--2"><div class="tableOfContents_RLlU thin-scrollbar"><ul class="table-of-contents table-of-contents__left-border"><li><a href="#rocket-new-feature" class="table-of-contents__link toc-highlight">🚀 New Feature</a></li><li><a href="#bug-bug-fix" class="table-of-contents__link toc-highlight">🐛 Bug Fix</a></li><li><a href="#nail_care-polish" class="table-of-contents__link toc-highlight">💅 Polish</a></li><li><a href="#memo-documentation" class="table-of-contents__link toc-highlight">📝 Documentation</a></li><li><a href="#house-internal" class="table-of-contents__link toc-highlight">🏠 Internal</a></li><li><a href="#committers-18" class="table-of-contents__link toc-highlight">Committers: 18</a></li></ul></div></div></div></div></div><Footer /></div>
