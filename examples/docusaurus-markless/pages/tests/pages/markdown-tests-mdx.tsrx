<span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'@theme/CodeBlock'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain"></span><span class="token keyword module" style="color: rgb(207, 34, 46);">import</span><span class="token plain"> </span><span class="token imports maybe-class-name">MyComponentSource</span><span class="token plain"> </span><span class="token keyword module" style="color: rgb(207, 34, 46);">from</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'./myComponent.js'</span><span class="token plain"> </span><span class="token keyword" style="color: rgb(207, 34, 46);">with</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token literal-property property" style="color: rgb(0, 92, 197);">type</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'text'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain"></span><span class="token tag punctuation" style="color: rgb(57, 58, 52);">&lt;</span><span class="token tag class-name" style="color: rgb(17, 99, 41);">CodeBlock</span><span class="token tag" style="color: rgb(34, 134, 58);"> </span><s