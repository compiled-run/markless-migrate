=\"er\"><style>#mermaid-svg-35{font-family:\"trebuchet ms\",verdana,arial,sans-serif;font-size:16px;fill:#ccc;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#mermaid-svg-35 .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#mermaid-svg-35 .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#mermaid-svg-35 .error-icon{fill:#a44141;}#mermaid-svg-35 .error-text{fill:#ddd;stroke:#ddd;}#mermaid-svg-35 .edge-thickness-normal{stroke-width:1px;}#mermaid-svg-35 .edge-thickness-thick{stroke-width:3.5px;}#mermaid-svg-35 .edge-pattern-solid{stroke-dasharray:0;}#mermaid-svg-35 .edge-thickness-invisible{stroke-width:0;fill:none;}#mermaid-svg-35 .edge-pattern-dashed{stroke-dasharray:3;}#mermaid-svg-35 .edge-pattern-dotted{stroke-dasharray:2;}#mermaid-svg-35 .marker{fill:lightgrey;stroke:lightgrey;}#mermaid-svg-35 .marker.cross{stroke:lightgrey;}#mermaid-svg-35 svg{font-family:\"trebuchet ms\",verdana,arial,sans-serif;font-size:16px;}#mermaid-svg-35 p{margin:0;}#mermaid-svg-35 .entityBox{fill:#1f2020;stroke:#ccc;}#mermaid-svg-35 .relationshipLabelBox{fill:hsl(20, 1.5873015873%, 12.3529411765%);opacity:0.7;background-color:hsl(20, 1.5873015873%, 12.3529411765%);}#mermaid-svg-35 .relationshipLabelBox rect{opacity:0.5;}#mermaid-svg-35 .labelBkg{background-color:rgba(32.0000000001, 31.3333333334, 31.0000000001, 0.5);}#mermaid-svg-35 .edgeLabel{background-color:hsl(0, 0%, 34.4117647059%);}#mermaid-svg-35 .edgeLabel .label rect{fill:hsl(0, 0%, 34.4117647059%);}#mermaid-svg-35 .edgeLabel .label text{fill:#ccc;}#mermaid-svg-35 .edgeLabel .label{fill:#ccc;font-size:14px;}#mermaid-svg-35 .label{font-family:\"trebuchet ms\",verdana,arial,sans-serif;color:#ccc;}#mermaid-svg-35 .edge-pattern-dashed{stroke-dasharray:8,8;}#mermaid-svg-35 .node rect,#mermaid-svg-35 .node circle,#mermaid-svg-35 .node ellipse,#mermaid-svg-35 .node polygon{fill:#1f2020;stroke:#ccc;stroke-width:1;}#mermaid-svg-35 .relationshipLine{stroke:lightgrey;stroke-width:1;fill:none;}#mermaid-svg-35 .marker{fill:none!important;stroke:lightgrey!important;stroke-width:1;}#mermaid-svg-35 [data-look=neo].labelBkg{background-color:rgba(32.0000000001, 31.3333333334, 31.0000000001, 0.5);}#mermaid-svg-35 .cluster rect{fill:hsl(180, 1.5873015873%, 28.3529411765%);stroke:rgba(255, 255, 255, 0.25);stroke-width:1px;}#mermaid-svg-35 .cluster text{fill:#F9FFFE;}#mermaid-svg-35 .cluster-label text{fill:#F9FFFE;}#mermaid-svg-35 .node .neo-node{stroke:#ccc;}#mermaid-svg-35 [data-look=\"neo\"].node rect,#mermaid-svg-35 [data-look=\"neo\"].cluster rect,#mermaid-svg-35 [data-look=\"neo\"].node polygon{stroke:url(#mermaid-svg-35-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#mermaid-svg-35 [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#mermaid-svg-35 [data-look=\"neo\"].node path{stroke:url(#mermaid-svg-35-gradient);stroke-width:1px;}#mermaid-svg-35 [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#mermaid-svg-35 [data-look=\"neo\"].node .neo-line path{stroke:#ccc;filter:none;}#mermaid-svg-35 [data-look=\"neo\"].node circle{stroke:url(#mermaid-svg-35-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#mermaid-svg-35 [data-look=\"neo\"].node circle .state-start{fill:#000000;}#mermaid-svg-35 [data-look=\"neo\"].icon-shape .icon{fill:url(#mermaid-svg-35-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#mermaid-svg-35 [data-look=\"neo\"].icon-shape .icon-neo path{stroke:url(#mermaid-svg-35-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#mermaid-svg-35 :root{--mermaid-font-family:\"trebuchet ms\",verdana,arial,sans-serif;}</style><g><defs><marker id=\"mermaid-svg-35_er-onlyOneStart\" class=\"marker onlyOne er\" refX=\"0\" refY=\"9\" markerWidth=\"18\" markerHeight=\"18\" orient=\"auto\" marker