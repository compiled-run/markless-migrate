c;}#_R_616m_-1 .relationshipLabelBox{fill:hsl(20, 1.5873015873%, 12.3529411765%);opacity:0.7;background-color:hsl(20, 1.5873015873%, 12.3529411765%);}#_R_616m_-1 .relationshipLabelBox rect{opacity:0.5;}#_R_616m_-1 .labelBkg{background-color:rgba(32.0000000001, 31.3333333334, 31.0000000001, 0.5);}#_R_616m_-1 .edgeLabel{background-color:hsl(0, 0%, 34.4117647059%);}#_R_616m_-1 .edgeLabel .label rect{fill:hsl(0, 0%, 34.4117647059%);}#_R_616m_-1 .edgeLabel .label text{fill:#ccc;}#_R_616m_-1 .edgeLabel .label{fill:#ccc;font-size:14px;}#_R_616m_-1 .label{font-family:\"trebuchet ms\",verdana,arial,sans-serif;color:#ccc;}#_R_616m_-1 .edge-pattern-dashed{stroke-dasharray:8,8;}#_R_616m_-1 .node rect,#_R_616m_-1 .node circle,#_R_616m_-1 .node ellipse,#_R_616m_-1 .node polygon{fill:#1f2020;stroke:#ccc;stroke-width:1;}#_R_616m_-1 .relationshipLine{stroke:lightgrey;stroke-width:1;fill:none;}#_R_616m_-1 .marker{fill:none!important;stroke:lightgrey!important;stroke-width:1;}#_R_616m_-1 [data-look=neo].labelBkg{background-color:rgba(32.0000000001, 31.3333333334, 31.0000000001, 0.5);}#_R_616m_-1 .cluster rect{fill:hsl(180, 1.5873015873%, 28.3529411765%);stroke:rgba(255, 255, 255, 0.25);stroke-width:1px;}#_R_616m_-1 .cluster text{fill:#F9FFFE;}#_R_616m_-1 .cluster-label text{fill:#F9FFFE;}#_R_616m_-1 .node .neo-node{stroke:#ccc;}#_R_616m_-1 [data-look=\"neo\"].node rect,#_R_616m_-1 [data-look=\"neo\"].cluster rect,#_R_616m_-1 [data-look=\"neo\"].node polygon{stroke:url(#_R_616m_-1-gradient);filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#_R_616m_-1 [data-look=\"neo\"].swimlane.cluster rect{filter:none;}#_R_616m_-1 [data-look=\"neo\"].node path{stroke:url(#_R_616m_-1-gradient);stroke-width:1px;}#_R_616m_-1 [data-look=\"neo\"].node .outer-path{filter:drop-shadow( 1px 2px 2px rgba(185,185,185,1));}#_R_616m_-1 [data-look=\"neo\"].node .neo-line path{stroke:#ccc;filter:none;}#_R_616m_-1 [data-look=\"neo\"].node circle{stroke:url(#_R_616m_-1-gradient);filter:drop-shadow( 1px 2px 2px r