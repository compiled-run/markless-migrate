" style="color: rgb(130, 80, 223);">require</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token string" style="color: rgb(198, 16, 95);">'./my-remark-plugin'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">rehypePlugins</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">[</span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">beforeDefaultRemarkPlugins</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">[</span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">beforeDefaultRehypePlugins</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="toke