52);"><span class="token plain">            </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">attributes</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">              </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">charset</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'utf-8'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">              </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">src</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'/noflash.js'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">            </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">          </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="