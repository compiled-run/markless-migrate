uation" style="color: rgb(57, 58, 52);">[</span><span class="token parameter punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token parameter punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token parameter" style="color: rgb(149, 56, 0);"> outDir</span><span class="token parameter punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token comment" style="color: rgb(107, 107, 107); font-style: italic;">// Print out to console all the rendered routes.</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">      routesPaths</span><span class="token punctuation" style="color: rgb(57, 58, 52);">.</span><span class="token method function property-access" style="color: rgb(130, 80, 223);">map</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token parameter" style="color: rgb(149, 56, 0);">route</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token plain"> </span><span class="token arrow operator" style="color: rgb(215, 58, 73);">=&gt;</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token console class-name" style="color: rgb(17, 99, 41);">console</span><span class="token punctuation" style="color: rgb(57, 58, 52);">.</span><span class="token method function property-access" style="color: rgb(130, 80, 223);">log</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token plain">route</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token punctuation" style="color: rgb(57, 58, 52);">;</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token punctuation" style="color: rgb(57, 58, 52);">;</span><span class="token plain"></span><br /></div><div class="token-line theme-code-block-highlighted-line" style="color: rgb(57, 58, 52);"><span class="token plain">    </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain"></span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><br /></div></code></pre><div class="buttonGroup_KXnS"><button type="button" aria-label="Copy code to clipboard" title="Copy" class="clean-btn"><span class="copyButtonIcons_gMWc" aria-hidden="true"><svg viewBox="0 0 24 24" class="copyButtonIcon_GXfb"><path fill="currentColor" d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"></path></svg><svg viewBox="0 0 24 24" class="copyButtonSuccessIcon_ktUX"><path fill="currentColor" d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"></path></svg></span></button></div></div></div>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="injectHtmlTags"><code>injectHtmlTags(&#123;content&#125;)</code><a href="#injectHtmlTags" class="hash-link" aria-label="Direct link to injectHtmlTags" title="Direct link to injectHtmlTags" translate="no">​</a></h2>{"\n"}<p>Inject head and/or body HTML tags to Docusaurus generated HTML.</p>{"\n"}<p><code>injectHtmlTags</code> will be called both with the content loaded by the plugin.</p>{"\n"}<div style="--prism-color: #393A34; --prism-background-color: #f6f8fa;" class="language-ts codeBlockContainer_jDV4 theme-code-block"><div class="codeBlockContent_cKMj"><pre tabindex="0" class="prism-code language-ts codeBlock_Gebt thin-scrollbar" style="color: rgb(57, 58, 52); background-color: rgb(246, 248, 250);"><code class="codeBlockLines_FJaf"><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token keyword" style="color: rgb(207, 34, 46);">function</span><span class="token plain"> </span><span class="token function" style="color: rgb(130, 80, 223);">injectHtmlTags</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  headTags</span><span class="token operator" style="color: rgb(215, 58, 73);">?</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> HtmlTags</span><span class="token punctuation" style="color: