ebar-container docSidebarContainer_S51O" data-mm-sidebar="default:api"><div class="sidebarViewport_K3q9"><div class="sidebar_vtcw sidebarWithHideableNavbar_tZ9s"><a tabindex="-1" class="sidebarLogo_UK0N" href="/"><img src="/img/docusaurus.svg" alt="" class="themedComponent_bJGS themedComponent--light_LEkC" height="32" width="32" data-mm-themed={"{\"light\":\"/img/docusaurus.svg\",\"dark\":\"/img/docusaurus_keytar.svg\"}"} /><b>Docusaurus</b></a><nav aria-label="Docs sidebar" class="menu thin-scrollbar menu_rWGR menuWithAnnouncementBar_Pf08"><ul class="theme-doc-sidebar-menu menu__list"><li class="theme-doc-sidebar-item-link theme-doc-sidebar-item-link-level-1 menu__list-item"><a class="menu__link" href="/docs/cli"><span class="linkLabel_ArQF">CLI</span></a></li><li class="theme-doc-sidebar-item-link theme-doc-sidebar-item-link-level-1 menu__list-item"><a class="menu__link" href="/docs/docusaurus-core"><span class="linkLabel_ArQF">Client API</span></a></li><li class="theme-doc-sidebar-item-link theme-doc-sidebar-item-link-level-1 menu__list-item"><a class="menu__link" href="/docs/api/docusaurus-config"><span class="linkLabel_ArQF">docusaurus.config.js</span></a></li><li class="theme-doc-sidebar-item-category theme-doc-sidebar-item-category-level-1 menu__list-item"><div class="menu__list-item-collapsible"><a class="categoryLink_vxMM menu__link menu__link--sublist menu__link--active" href="/docs/api/plugin-methods"><span class="categoryLinkLabel_O4bj">Plugin method references</span></a><button aria-label="Collapse sidebar category 'Plugin method references'" aria-expanded="true" type="button" class="clean-btn menu__caret"></button></div><ul class="menu__list" style="display: block; overflow: visible; height: auto;"><li class="theme-doc-sidebar-item-link theme-doc-sidebar-item-link-level-2 menu__list-item"><a class="menu__link" tabindex="0" href="/docs/api/plugin-methods/lifecycle-apis"><span class="linkLabel_ArQF">Lifecycle APIs</span></a></li><li class="theme-doc-side