lass="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">    </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">    </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">type</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'category'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">label</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'Guides'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">link</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">type</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'generated-index'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">title</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'Docusaurus Guides'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">description</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">          </span><span class="token string" style="color: rgb(198, 16, 95);">"Let's learn about the most important Docusaurus concepts!"</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">keywords</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">[</span><span class="token string" style="color: rgb(198, 16, 95);">'guides'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">image</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token string" style="color: rgb(198, 16, 95);">'/img/docusaurus.png'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token literal-property property" style="color: rgb(0, 92, 197);">items</span><span class="token operator" style="color: rgb(215, 58, 73);">:</span><span class="token plain"> </span><span class="token punctuation" style="color: rgb(57, 58, 52);">[</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token string" style="color: rgb(198, 16, 95);">'guides/creating-pages'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#123;</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">          </span><span class="token literal-property property" style="