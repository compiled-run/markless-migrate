</span><span class="token punctuation" style="color: rgb(57, 58, 52);">(</span><span class="token string" style="color: rgb(198, 16, 95);">'rehype-katex'</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token punctuation" style="color: rgb(57, 58, 52);">)</span><span class="token punctuation" style="color: rgb(57, 58, 52);">.</span><span class="token keyword module" style="color: rgb(207, 34, 46);">default</span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">          </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">        </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">      </span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">    </span><span class="token punctuation" style="color: rgb(57, 58, 52);">]</span><span class="token punctuation" style="color: rgb(57, 58, 52);">,</span><span class="token plain"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">  </span><span class="token punctuation" style="color: rgb(57, 58, 52);">&#125;</span><span class="token punctuation" sty