span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">:::tip[Deep Child]</span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">Deep child content</span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">:::</span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">::::</span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain" style="display: inline-block;"></span><br /></div><div class="token-line" style="color: rgb(57, 58, 52);"><span class="token plain">:::::</span><br /></div></code></pre><div class="buttonGroup_KXnS"><button type="button" aria-label="Copy code to clipboard" title="Copy" class="clean-btn"><span class="copyButtonIcons_gMWc" aria-hidden="true"><svg viewBox="0 0 24 24" class="copyButtonIcon_GXfb"><path fill="currentColor" d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"></path></svg><svg viewBox="0 0 24 24" class="copyButtonSuccessIcon_ktUX"><path fill="currentColor" d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"></path></svg></span></button></div></div></div>{"\n"}<div class="browserWindow_my1Q"><div class="browserWindowHeader_jXSR"><div class="buttons_uHc7"><span class="dot_giz1" style="background:#f25f58"></span><span class="