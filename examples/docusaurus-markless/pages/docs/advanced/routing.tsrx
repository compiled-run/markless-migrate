ng\",\"label\":\"Swizzling\",\"docId\":\"swizzling\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/static-assets\",\"label\":\"Static Assets\",\"docId\":\"static-assets\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/search\",\"label\":\"Search\",\"docId\":\"search\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/browser-support\",\"label\":\"Browser support\",\"docId\":\"browser-support\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/seo\",\"label\":\"SEO\",\"docId\":\"seo\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/using-plugins\",\"label\":\"Using Plugins\",\"docId\":\"using-plugins\",\"unlisted\":false},{\"type\":\"category\",\"label\":\"Deployment\",\"items\":[{\"type\":\"link\",\"href\":\"/docs/deployment/github-pages\",\"label\":\"GitHub Pages\",\"docId\":\"deployment/github-pages\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/deployment/netlify\",\"label\":\"Netlify\",\"docId\":\"deployment/netlify\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/deployment/vercel\",\"label\":\"Vercel\",\"docId\":\"deployment/vercel\",\"unlisted\":false}],\"collapsed\":true,\"collapsible\":true,\"href\":\"/docs/deployment/\"},{\"type\":\"category\",\"label\":\"Internationalization\",\"items\":[{\"type\":\"link\",\"href\":\"/docs/i18n/tutorial\",\"label\":\"Tutorial\",\"docId\":\"i18n/tutorial\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/i18n/git\",\"label\":\"Using Git\",\"docId\":\"i18n/git\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/i18n/crowdin\",\"label\":\"Using Crowdin\",\"docId\":\"i18n/crowdin\",\"unlisted\":false}],\"collapsed\":true,\"collapsible\":true,\"href\":\"/docs/i18n/introduction\"},{\"type\":\"link\",\"href\":\"/docs/guides/whats-next\",\"label\":\"What's next?\",\"docId\":\"guides/whats-next\",\"unlisted\":false}],\"collapsed\":true,\"collapsible\":true,\"href\":\"/docs/category/guides\"},{\"type\":\"category\",\"label\":\"Advanced Guides\",\"items\":[{\"type\":\"link\",\"href\":\"/docs/advanced/architecture\",\"label\":\"Architecture\",\"docId\":\"advanced/architecture\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/advanced/plugins\",\"label\":\"Plugins\",\"docId\":\"advanced/plugins\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/advanced/routing\",\"label\":\"Routing\",\"docId\":\"advanced/routing\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/advanced/ssg\",\"label\":\"Static site generation\",\"docId\":\"advanced/ssg\",\"unlisted\":false},{\"type\":\"link\",\"href\":\"/docs/advanced/client\",\"label\":\"Client architecture\",\"docId\":\"advanced/client\",\"unlisted\":false}],\"collapsed\":true,\"collapsible\":true,\"href\":\"/docs/advanced/\"},{\"type\":\"category\",\"label\":\"Upgrading\",\"items\":[{\"type\":\"link\",\"href\":\"/docs/migration/v3\",\"label\":\"To Docusaurus v3\",\"docId\":\"migration/v3\",\"unlisted\":false}],\"collapsed\":true,\"collapsible\":true,\"href\":\"/docs/migration\"}]"}</script></aside><main class="docMainContainer_EfwR"><div class="container padding-top--md padding-bottom--lg"><div class="row"><div class="col docItemCol_n6xZ"><div class="docItemContainer_RhpI"><article><nav class="theme-doc-breadcrumbs breadcrumbsContainer_Wvrh" aria-label="Breadcrumbs"><ul class="breadcrumbs"><li class="breadcrumbs__item"><a aria-label="Home page" class="breadcrumbs__link" href="/"><svg viewBox="0 0 24 24" class="breadcrumbHomeIcon_uaSn"><path d="M10 19v-5h4v5c0 .55.45 1 1 1h3c.55 0 1-.45 1-1v-7h1.7c.46 0 .68-.57.33-.87L12.67 3.6c-.38-.34-.96-.34-1.34 0l-8.36 7.53c-.34.3-.13.87.33.87H5v7c0 .55.45 1 1 1h3c.55 0 1-.45 1-1z" fill="currentColor"></path></svg></a></li><li class="breadcrumbs__item"><a class="breadcrumbs__link" href="/docs/advanced"><span>Advanced Guides</span></a></li><li class="breadcrumbs__item breadcrumbs__item--active"><span class="breadcrumbs__link">Routing</span></li></ul></nav><div class="tocCollapsible_BEWm theme-doc-toc-mobile tocMobile_NSfz"><button type="button" class="clean-btn tocCollapsibleButton_IbtT">On this page</button></div><div class="theme-doc-markdown markdown"><header><h1>Routing</h1></header>{"\n\n"}<p>Docusaurus' routing system follows single-page application conventions: one route, one component. In this section, we will begin by talking about routing within the three content plugins (docs, blog, and pages), and then go beyond to talk about the underlying routing system.</p>{"\n"}<h2 class="anchor anchorTargetHideOnScrollNavbar_qJOx" id="routing-in-content-plugins">Routing in content plugins<a href="#routing-in-content-plugins" class="hash-link" aria-label="Direct link to Routing in content plugins" title="Direct link to Routing in content plugins" translate="no">​</a></h2>{"\n"}<p>Every content plugin provides a <code>routeBasePath</code> option. It defines where the plugins append their routes to. By default, the docs plugin puts its routes under <code>/docs</code>; the blog plugin, <code>/blog</code>; and the pages plugin, <code>/</code>. You can think about the route structure like this:</p>{"\n"}<div class="docusaurus-mermaid-container container_RUsj" data-mm-mermaid-dark={"<svg id=\"_R_1ahralaqh_-1\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\" class=\"flowchart\" style=\"max-width: 848.254150390625px;\" viewBox=\"4 4 848.254150390625 312\" role=\"graphics-document document\" aria-roledescription=\"flowchart-v2\"><style>#_R_1ahralaqh_-1{font-family:\"trebuchet ms\",verdana,arial,sans-serif;font-size:16px;fill:#ccc;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#_R_1ahralaqh_-1 .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#_R_1ahralaqh_-1 .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#_R_1ahralaqh_-1 .error-icon{fill:#a44141;}#_R_1ahralaqh_-1 .error-text{fill