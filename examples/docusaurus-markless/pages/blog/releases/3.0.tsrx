tate(-90)\">Low Engagement</text></g><g class=\"label\"><text x=\"0\" y=\"0\" fill=\"#e0dfdf\" font-size=\"16\" dominant-baseline=\"hanging\" text-anchor=\"middle\" transform=\"translate(5, 151) rotate(-90)\">High Engagement</text></g></g><g class=\"title\"><text x=\"0\" y=\"0\" fill=\"#e0dfdf\" font-size=\"20\" dominant-baseline=\"hanging\" text-anchor=\"middle\" transform=\"translate(250, 10) rotate(0)\">Reach and engagement of campaigns</text></g></g></svg>"}><svg id="_R_6hmldeh_-0" width="100%" xmlns="http://www.w3.org/2000/svg" style="max-width: 500px;" viewBox="0 0 500 500" role="graphics-document document" aria-roledescription="quadrantChart"><script>{"(function(s){var e=document.createElementNS(s.parentNode.namespaceURI,\"style\");e.textContent=\"#_R_6hmldeh_-0{font-family:\\\"trebuchet ms\\\",verdana,arial,sans-serif;font-size:16px;fill:#333;}@keyframes edge-animation-frame{from{stroke-dashoffset:0;}}@keyframes dash{to{stroke-dashoffset:0;}}#_R_6hmldeh_-0 .edge-animation-slow{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 50s linear infinite;stroke-linecap:round;}#_R_6hmldeh_-0 .edge-animation-fast{stroke-dasharray:9,5!important;stroke-dashoffset:900;animation:dash 20s linear infinite;stroke-linecap:round;}#_R_6hmldeh_-0 .error-icon{fill:#552222;}#_R_6hmldeh_-0 .error-text{fill:#552222;stroke:#552222;}#_R_6hmldeh_-0 .edge-thickness-normal{stroke-width:1px;}#_R_6hmldeh_-0 .edge-thickness-thick{stroke-width:3.5px;}#_R_6hmldeh_-0 .edge-pattern-solid{stroke-dasharray:0;}#_R_6hmldeh_-0 .edge-thickness-invisible{stroke-width:0;fill:none;}#_R_6hmldeh_-0 .edge-pattern-dashed{stroke-dasharray:3;}#_R_6hmldeh_-0 .edge-pattern-dotted{stroke-dasharray:2;}#_R_6hmldeh_-0 .marker{fill:#333333;stroke:#333333;}#_R_6hmldeh_-0 .marker.cross{stroke:#333333;}#_R_6hmldeh_-0 svg{font-family:\\\"trebuchet ms\\\",verdana,arial,sans-serif;font-size:16px;}#_R_6hmldeh_-0 p{margin:0;}#_R_6hmldeh_-0 .node .neo-node{stroke:#9370DB;}#_R_6hmldeh_-0 [data-look=\\\"neo\\\