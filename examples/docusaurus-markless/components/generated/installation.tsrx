												{"\n"}
												<p>
													{"To check that the update occurred successfully, run:"}
												</p>
												{"\n"}
												<div class="language-bash codeBlockContainer_jDV4 theme-code-block" style="--prism-color: #393A34; --prism-background-color: #f6f8fa;">
													<div class="codeBlockContent_cKMj">
														<pre tabindex="0" class="prism-code language-bash codeBlock_Gebt thin-scrollbar" style="color: rgb(57, 58, 52); background-color: rgb(246, 248, 250);">
															<code class="codeBlockLines_FJaf">
																<div class="token-line" style="color: rgb(57, 58, 52);">
																	<span class="token plain">
																		{"npx docusaurus "}
																	</span>
																	<span class="token parameter variable" style="color: rgb(227, 98, 9);">
																		{"--version"}
																	</span>
