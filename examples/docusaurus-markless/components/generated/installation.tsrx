													<div class="admonitionContent_Knsx">
														<p>
															{"If you are setting up a new Docusaurus website for a Meta open source project, run this command inside an internal repository, which comes with some useful Meta-specific defaults:"}
														</p>
														<div class="language-bash codeBlockContainer_jDV4 theme-code-block" style="--prism-color: #393A34; --prism-background-color: #f6f8fa;">
															<div class="codeBlockContent_cKMj">
																<pre tabindex="0" class="prism-code language-bash codeBlock_Gebt thin-scrollbar" style="color: rgb(57, 58, 52); background-color: rgb(246, 248, 250);">
																	<code class="codeBlockLines_FJaf">
																		<div class="token-line" style="color: rgb(57, 58, 52);">
																			<span class="token plain">
																				{"scarf static-docs-bootstrap"}
																			</span>
																			<br />
																		</div>
																	</code>
																</pre>
																<div class="buttonGroup_KXnS">
																	<button type="button" aria-label="Copy code to clipboard" title="Copy" class="clean-btn">
																		<span class="copyButtonIcons_gMWc" aria-hidden="true">
																			<svg viewBox="0 0 24 24" class="copyButtonIcon_GXfb">
																				<path fill="currentColor" d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"></path>
																			</svg>
																			<svg viewBox="0 0 24 24" class="copyButtonSuccessIcon_ktUX">
																				<path fill="currentColor" d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"></path>
																			</svg>
																		</span>
																	</button>
																</div>
															</div>
														</div>
													</div>
												</div>
												{"\n"}
												<details class="details_Nokh isBrowser_QrB5 alert alert--info details_Cn_P" data-collapsed="true">
													<summary>
														{"Alternative installation commands"}
													</summary>
													<div style="display: none; overflow: hidden; height: 0px;">
														<div class="collapsibleContent_EoA1">
															<p>
																{"You can also initialize a new project using your preferred project manager:"}
															</p>
															<div class="theme-tabs-container tabList_Qoir">
																<ul role="tablist" aria-orientation="horizontal" class="tabs">
																	<li role="tab" tabindex="0" aria-selected="true" class="tabs__item tabItem_AQgk tabs__item--active">
																		{"npm"}
																	</li>
																	<li role="tab" tabindex="-1" aria-selected="false" class="tabs__item tabItem_AQgk">
																		{"Yarn"}
																	</li>
																	<li role="tab" tabindex="-1" aria-selected="false" class="tabs__item tabItem_AQgk">
																		{"pnpm"}
																	</li>
																	<li role="tab" tabindex="-1" aria-selected="false" class="tabs__item tabItem_AQgk">
																		{"Bun"}
																	</li>
																</ul>
																<div class="margin-top--md">
																	<div role="tabpanel" class="tabItem_pnkT">
