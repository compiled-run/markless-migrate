export default function Attribution() @{
	<p class="port-attribution" style="position: fixed; right: 8px; bottom: 8px; z-index: 50; max-width: 360px; margin: 0; padding: 6px 10px; border-radius: 6px; font: 12px/1.4 system-ui, sans-serif; text-align: left; color: #222; background: #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);">Unofficial demo copy of <a style="color: #1a4fa0; text-decoration: underline;" href="https://alpinejs.dev">alpinejs.dev</a>. Alpine.js and its documentation © Caleb Porzio and contributors, <a style="color: #1a4fa0; text-decoration: underline;" href="https://github.com/alpinejs/alpine/blob/main/LICENSE.md">MIT license</a>.</p>
}
