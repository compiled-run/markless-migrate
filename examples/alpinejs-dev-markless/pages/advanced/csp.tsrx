92E;">{"loading "}</span><span style="color: #D73A49;">{"&&"}</span><span style="color: #24292E;">{" count "}</span><span style="color: #D73A49;">{">"}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"0"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ✅ These work -->\n<div x-data=\"{ count: 5, name: 'Alpine' }\">\n    <span x-text=\"count + 10\"></span>\n    <span x-text=\"count > 3\"></span>\n    <span x-text=\"count === 5 ? 'Yes' : 'No'\"></span>\n    <span x-text=\"'Hello ' + name\"></span>\n    <div x-show=\"!loading && count > 0\"></div>\n</div>"}</div></code></pre>
				<h3 id="assignments-and-updates">Assignments and Updates</h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- ✅ These work -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ count: "}</span><span style="color: #005CC5;">{"0"}</span><span style="color: #24292E;">{", user: { name: "}</span><span style="color: #032F62;">{"''"}</span><span style="color: #24292E;">{" } }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"count"}</span><span style="color: #D73A49;">{"++"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Increment</"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"count "}</span><span style="color: #D73A49;">{"="}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"0"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Reset</"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"input"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-model"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"user.name"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ✅ These work -->\n<div x-data=\"{ count: 0, user: { name: '' } }\">\n    <button x-on:click=\"count++\">Increment</button>\n    <button x-on:click=\"count = 0\">Reset</button>\n    <input x-model=\"user.name\">\n</div>"}</div></code></pre>
				<h3 id="method-calls">Method Calls</h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- ✅ These work -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ items: ["}</span><span style="color: #032F62;">{"'a'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #032F62;">{"'b'"}</span><span style="color: #24292E;">{"] }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"items."}</span><span style="color: #6F42C1;">{"push"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'c'"}</span><span style="color: #24292E;">{")"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Add Item</"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ✅ These work -->\n<div x-data=\"{ items: ['a', 'b'] }\">\n    <button x-on:click=\"items.push('c')\">Add Item</button>\n</div>"}</div></code></pre>
				<h2 id="whats-not-supported"><a href="#whats-not-supported">What's Not Supported</a></h2>
				<p>Some advanced and potentially dangerous JavaScript features aren't supported:</p>
				<h3 id="complex-expressions">Complex Expressions</h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- ❌ These don't work -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ user: { name: "}</span><span style="color: #032F62;">{"''"}</span><span style="color: #24292E;">{" } }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"<!-- Property assignments -->"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"user.name "}</span><span style="color: #D73A49;">{"="}</span><span style="color: #24292E;">{" "}</span><span style="color: #032F62;">{"'John'\""}</span><span style="color: #24292E;">{">Bad</"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"<!-- Arrow functions -->"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"() "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" console."}</span><span style="color: #6F42C1;">{"log"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'hi'"}</span><span style="color: #24292E;">{")"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Bad</"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"<!-- Destructuring -->"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ name } "}</span><span style="color: #D73A49;">{"="}</span><span style="color: #24292E;">{" user"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Bad</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"<!-- Template literals -->"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\"`Hello ${"}</span><span style="color: #24292E;">{"name"}</span><span style="color: #032F62;">{"}`\""}</span><span style="color: #24292E;">{">Bad</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"<!-- Spread operator -->"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ "}</span><span style="color: #D73A49;">{"..."}</span><span style="color: #24292E;">{"defaults }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">Bad</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ❌ These don't work -->\n<div x-data=\"{ user: { name: '' } }\">\n    <!-- Property assignments -->\n    <button x-on:click=\"user.name = 'John'\">Bad</button>\n\n    <!-- Arrow functions -->\n    <button x-on:click=\"() => console.log('hi')\">Bad</button>\n\n    <!-- Destructuring -->\n    <div x-text=\"{ name } = user\">Bad</div>\n\n    <!-- Template literals -->\n    <div x-text=\"`Hello ${name}`\">Bad</div>\n\n    <!-- Spread operator -->\n    <div x-data=\"{ ...defaults }\">Bad</div>\n</div>"}</div></code></pre>
				<h3 id="global-variables-and-functions">Global Variables and Functions</h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- ❌ These don't work -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-on"}</span><span style="color: #24292E;">{":"}</span><span style="color: #6F42C1;">{"click"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"console."}</span><span style="color: #6F42C1;">{"log"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'hi'"}</span><span style="color: #24292E;">{")"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"document.title"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"window.innerWidth"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #005CC5;">{"Math"}</span><span style="color: #24292E;">{"."}</span><span style="color: #005CC5;">{"max"}</span><span style="color: #24292E;">{"(count, "}</span><span style="color: #005CC5;">{"100"}</span><span style="color: #24292E;">{")"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #005CC5;">{"parseInt"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'123'"}</span><span style="color: #24292E;">{") "}</span><span style="color: #D73A49;">{"+"}</span><span style="color: #24292E;">{" count"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #005CC5;">{"JSON"}</span><span style="color: #24292E;">{"."}</span><span style="color: #005CC5;">{"stringify"}</span><span style="color: #24292E;">{"({ value: count })"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ❌ These don't work -->\n<div x-data>\n    <button x-on:click=\"console.log('hi')\"></button>\n    <span x-text=\"document.title\"></span>\n    <span x-text=\"window.innerWidth\"></span>\n    <span x-text=\"Math.max(count, 100)\"></span>\n    <span x-text=\"parseInt('123') + count\"></span>\n    <span x-text=\"JSON.stringify({ value: count })\"></span>\n</div>"}</div></code></pre>
				<h3 id="html-injection">HTML Injection</h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- ❌ These don't work -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ message: "}</span><span style="color: #032F62;">{"'Hello <span>World</span>'"}</span><span style="color: #24292E;">{" }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-html"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"message"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-init"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"$el."}</span><span style="color: #6F42C1;">{"insertAdjacentHTML"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'beforeend'"}</span><span style="color: #24292E;">{", message)"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- ❌ These don't work -->\n<div x-data=\"{ message: 'Hello <span>World</span>' }\">\n    <span x-html=\"message\"></span>\n    <span x-init=\"$el.insertAdjacentHTML('beforeend', message)\"></span>\n</div>"}</div></code></pre>
				<h2 id="when-to-extract-logic"><a href="#when-to-extract-logic">When to Extract Logic</a></h2>
				<p>
					While the CSP build supports simple inline expressions, you'll want to extract complex logic into dedicated functions or Alpine.data() components for better organization:
				</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- Instead of this -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ users: [] }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-show"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"users."}</span><span style="color: #6F42C1;">{"filter"}</span><span style="color: #24292E;">{"("}</span><span style="color: #E36209;">{"u"}</span><span style="color: #24292E;">{" "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" u.active "}</span><span style="color: #D73A49;">{"&&"}</span><span style="color: #24292E;">{" u.role "}</span><span style="color: #D73A49;">{"==="}</span><span style="color: #24292E;">{" "}</span><span style="color: #032F62;">{"'admin'"}</span><span style="color: #24292E;">{")."}</span><span style="color: #005CC5;">{"length"}</span><span style="color: #24292E;">{" "}</span><span style="color: #D73A49;">{">"}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"0"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- Instead of this -->\n<div x-data=\"{ users: [] }\" x-show=\"users.filter(u => u.active && u.role === 'admin').length > 0\">"}</div></code></pre>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #6A737D;">{"<!-- Do this -->"}</span></div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"userManager"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-show"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"hasActiveAdmins"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"script"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"nonce"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\"...\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    Alpine."}</span><span style="color: #6F42C1;">{"data"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'userManager'"}</span><span style="color: #24292E;">{", () "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" ({"}</span></div><div class="line"><span style="color: #24292E;">{"        users: [],"}</span></div><div class="line">{" "}</div><div class="line"><span style="color: #24292E;">{"        "}</span><span style="color: #D73A49;">{"get"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"hasActiveAdmins"}</span><span style="color: #24292E;">{"() {"}</span></div><div class="line"><span style="color: #24292E;">{"            "}</span><span style="color: #D73A49;">{"return"}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"this"}</span><span style="color: #24292E;">{".users."}</span><span style="color: #6F42C1;">{"filter"}</span><span style="color: #24292E;">{"("}</span><span style="color: #E36209;">{"u"}</span><span style="color: #24292E;">{" "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" u.active "}</span><span style="color: #D73A49;">{"&&"}</span><span style="color: #24292E;">{" u.role "}</span><span style="color: #D73A49;">{"==="}</span><span style="color: #24292E;">{" "}</span><span style="color: #032F62;">{"'admin'"}</span><span style="color: #24292E;">{")."}</span><span style="color: #005CC5;">{"length"}</span><span style="color: #24292E;">{" "}</span><span style="color: #D73A49;">{">"}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"0"}</span></div><div class="line"><span style="color: #24292E;">{"        }"}</span></div><div class="line"><span style="color: #24292E;">{"    }))"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"script"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<!-- Do this -->\n<div x-data=\"userManager\" x-show=\"hasActiveAdmins\">\n\n<script nonce=\"...\">\n    Alpine.data('userManager', () => ({\n        users: [],\n\n        get hasActiveAdmins() {\n            return this.users.filter(u => u.active && u.role === 'admin').length > 0\n        }\n    }))\n</script>"}</div></code></pre>
				<p>This approach makes your code more readable, testable, and maintainable, especially for complex applications.</p>
				<h2 id="csp-headers"><a href="#csp-headers">CSP Headers</a></h2>
				<p>Here's an example CSP header that works with Alpine's CSP build:</p>
				<pre><code data-theme="github-light" data-lang="text" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"Content-Security-Policy: default-src 'self'; script-src 'nonce-[random]' 'strict-dynamic';"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\nContent-Security-Policy: default-src 'self'; script-src 'nonce-[random]' 'strict-dynamic';"}</div></code></pre>
				<p>
					The key is removing{" "}<code>'unsafe-eval'</code>{" "}from your{" "}<code>script-src</code>{" "}directive while still allowing your nonce-based scripts to run.
				</p>
				<Sponsor wrapper="my-12 border-y border-gray-200 py-6 xl:hidden" label="mb-3 block text-xs font-semibold uppercase tracking-wider text-gray-400" />
				<div class="flex justify-between border-t border-gray-200 pt-4 text-gray-700">
					<div>
						<a class="font-bold text-cyan-400" href="/plugins/sort">← Sort</a>
					</div>
					<div>
						<a class="font-bold text-cyan-400" href="/advanced/reactivity">Reactivity →</a>
