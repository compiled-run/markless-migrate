import DocsSidebar from '../../components/docs-sidebar.tsrx';
import Sponsor from '../../components/sponsor.tsrx';
import Toc from '../../components/toc.tsrx';
import Attribution from '../../components/attribution.tsrx';
import { watchHeadings } from '../../site.ts';

const HEADINGS = [{ key: 0, id: "element-initialization", text: "Element initialization", level: 2 }, { key: 1, id: "after-a-state-change", text: "After a state change", level: 2 }, { key: 2, id: "watch", text: "$watch", level: 3 }, { key: 3, id: "x-effect", text: "x-effect", level: 3 }, { key: 4, id: "alpine-initialization", text: "Alpine initialization", level: 2 }, { key: 5, id: "alpine-initializing", text: "alpine:init", level: 3 }, { key: 6, id: "alpine-initialized", text: "alpine:initialized", level: 3 }] as const;

export default function DocsPage({ url }: PageProps) @{
	<div style="display: contents">
		<DocsHeader pathname={url.pathname} />
		<DocsSidebar pathname={url.pathname} />
		<main class="pt-32 pl-0 pr-0 md:pl-48 lg:pl-64 xl:pr-64" onIdle={(event) => watchHeadings(event.target as HTMLElement)}>
			<div class="m-auto max-w-3xl px-6 pb-24 text-gray-800 antialiased markdown" listen-for-intersection-of-titles="">
				<h1>Lifecycle</h1>
				<p>
					Alpine has a handful of different techniques for hooking into different parts of its lifecycle. Let&#39;s go through the most useful ones to familiarize yourself with:
				</p>
				<h2 id="element-initialization"><a href="#element-initialization">Element initialization</a></h2>
				<p>Another extremely useful lifecycle hook in Alpine is the{" "}<code>x-init</code>{" "}directive.</p>
				<p>
					<code>x-init</code>{" "}can be added to any element on a page and will execute any JavaScript you call inside it when Alpine begins initializing that element.
				</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"button"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-init"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"console."}</span><span style="color: #6F42C1;">{"log"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'Im initing'"}</span><span style="color: #24292E;">{")"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<button x-init=\"console.log('Im initing')\">"}</div></code></pre>
				<p>In addition to the directive, Alpine will automatically call any{" "}<code>init()</code>{" "}methods stored on a data object. For example:</p>
				<pre><code data-theme="github-light" data-lang="js" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"Alpine."}</span><span style="color: #6F42C1;">{"data"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'dropdown'"}</span><span style="color: #24292E;">{", () "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" ({"}</span></div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6F42C1;">{"init"}</span><span style="color: #24292E;">{"() {"}</span></div><div class="line"><span style="color: #24292E;">{"        "}</span><span style="color: #6A737D;">{"// I get called before the element using this data initializes."}</span></div><div class="line"><span style="color: #24292E;">{"    }"}</span></div><div class="line"><span style="color: #24292E;">{"}))"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\nAlpine.data('dropdown', () => ({\n    init() {\n        // I get called before the element using this data initializes.\n    }\n}))"}</div></code></pre>
				<h2 id="after-a-state-change"><a href="#after-a-state-change">After a state change</a></h2>
				<p>
					Alpine allows you to execute code when a piece of data (state) changes. It offers two different APIs for such a task:{" "}<code>$watch</code>{" "}and{" "}<code>x-effect</code>.
				</p>
				<h3 id="watch"><a href="#watch"><code>$watch</code></a></h3>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ open: "}</span><span style="color: #005CC5;">{"false"}</span><span style="color: #24292E;">{" }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-init"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #6F42C1;">{"$watch"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'open'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #E36209;">{"value"}</span><span style="color: #24292E;">{" "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" console."}</span><span style="color: #6F42C1;">{"log"}</span><span style="color: #24292E;">{"(value))"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<div x-data=\"{ open: false }\" x-init=\"$watch('open', value => console.log(value))\">"}</div></code></pre>
				<p>
					As you can see above,{" "}<code>$watch</code>{" "}allows you to hook into data changes using a dot-notation key. When that piece of data changes, Alpine will call the passed callback and pass it the new value. along with the old value before the change.
				</p>
				<p><a href="/magics/watch">→ Read more about $watch</a></p>
				<h3 id="x-effect"><a href="#x-effect"><code>x-effect</code></a></h3>
				<p><code>x-effect</code>{" "}uses the same mechanism under the hood as{" "}<code>$watch</code>{" "}but has very different usage.</p>
				<p>
					Instead of specifying which data key you wish to watch,{" "}<code>x-effect</code>{" "}will call the provided code and intelligently look for any Alpine data used within it. Now when one of those pieces of data changes, the{" "}<code>x-effect</code>{" "}expression will be re-run.
				</p>
				<p>Here&#39;s the same bit of code from the{" "}<code>$watch</code>{" "}example rewritten using{" "}<code>x-effect</code>:</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ open: "}</span><span style="color: #005CC5;">{"false"}</span><span style="color: #24292E;">{" }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-effect"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"console."}</span><span style="color: #6F42C1;">{"log"}</span><span style="color: #24292E;">{"(open)"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<div x-data=\"{ open: false }\" x-effect=\"console.log(open)\">"}</div></code></pre>
				<p>Now, this expression will be called right away, and re-called every time{" "}<code>open</code>{" "}is updated.</p>
				<p>The two main behavioral differences with this approach are:</p>
				<ol>
					<li>The provided code will be run right away AND when data changes (<code>$watch</code>{" "}is "lazy" -- won&#39;t run until the first data change)</li>
					<li>No knowledge of the previous value. (The callback provided to{" "}<code>$watch</code>{" "}receives both the new value AND the old one)</li>
				</ol>
				<p><a href="/directives/effect">→ Read more about x-effect</a></p>
				<h2 id="alpine-initialization"><a href="#alpine-initialization">Alpine initialization</a></h2>
				<h3 id="alpine-initializing"><a href="#alpine-initializing"><code>alpine:init</code></a></h3>
				<p>Ensuring a bit of code executes after Alpine is loaded, but BEFORE it initializes itself on the page is a necessary task.</p>
				<p>This hook allows you to register custom data, directives, magics, etc. before Alpine does its thing on a page.</p>
				<p>You can hook into this point in the lifecycle by listening for an event that Alpine dispatches called:{" "}<code>alpine:init</code></p>
				<pre><code data-theme="github-light" data-lang="js" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"document."}</span><span style="color: #6F42C1;">{"addEventListener"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'alpine:init'"}</span><span style="color: #24292E;">{", () "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" {"}</span></div><div class="line"><span style="color: #24292E;">{"    Alpine."}</span><span style="color: #6F42C1;">{"data"}</span><span style="color: #24292E;">{"("}</span><span style="color: #D73A49;">{"..."}</span><span style="color: #24292E;">{")"}</span></div><div class="line"><span style="color: #24292E;">{"})"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\ndocument.addEventListener('alpine:init', () => {\n    Alpine.data(...)\n})"}</div></code></pre>
				<h3 id="alpine-initialized"><a href="#alpine-initialized"><code>alpine:initialized</code></a></h3>
				<p>Alpine also offers a hook that you can use to execute code AFTER it&#39;s done initializing called{" "}<code>alpine:initialized</code>:</p>
				<pre><code data-theme="github-light" data-lang="js" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"document."}</span><span style="color: #6F42C1;">{"addEventListener"}</span><span style="color: #24292E;">{"("}</span><span style="color: #032F62;">{"'alpine:initialized'"}</span><span style="color: #24292E;">{", () "}</span><span style="color: #D73A49;">{"=>"}</span><span style="color: #24292E;">{" {"}</span></div><div class="line"><span style="color: #24292E;">{"    "}</span><span style="color: #6A737D;">{"//"}</span></div><div class="line"><span style="color: #24292E;">{"})"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\ndocument.addEventListener('alpine:initialized', () => {\n    //\n})"}</div></code></pre>
				<Sponsor wrapper="my-12 border-y border-gray-200 py-6 xl:hidden" label="mb-3 block text-xs font-semibold uppercase tracking-wider text-gray-400" />
				<div class="flex justify-between border-t border-gray-200 pt-4 text-gray-700">
					<div>
						<a class="font-bold text-cyan-400" href="/essentials/events">← Events</a>
					</div>
					<div>
						<a class="font-bold text-cyan-400" href="/directives/data">x-data →</a>
					</div>
				</div>
				<p class="mt-6 text-center text-sm text-gray-600">Code highlighting provided by <a href="https://torchlight.dev" target="__blank" class="font-semibold text-cyan-400">Torchlight</a></p>
				<div class="mt-6 flex items-center justify-center gap-4 text-center text-sm text-gray-600"></div>
				<Attribution />
			</div>
		</main>
		<Toc headings={HEADINGS} />
	</div>
}
