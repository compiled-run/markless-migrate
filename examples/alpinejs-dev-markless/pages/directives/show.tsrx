<span style="color: #24292E;">{"        Dropdown Contents..."}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"div"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<div x-data=\"{ open: false }\">\n    <button x-on:click=\"open = ! open\">Toggle Dropdown</button>\n\n    <div x-show.important=\"open\">\n        Dropdown Contents...\n    </div>\n</div>"}</div></code></pre>
