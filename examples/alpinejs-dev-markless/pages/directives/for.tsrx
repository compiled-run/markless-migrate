const HEADINGS = [{ key: 0, id: "keys", text: "Keys", level: 2 }, { key: 1, id: "accessing-indexes", text: "Accessing indexes", level: 2 }, { key: 2, id: "iterating-over-a-range", text: "Iterating over a range", level: 2 }, { key: 3, id: "contents-of-a-template", text: "Contents of a <template>", level: 2 }] as const;

export default function DocsPage({ url }: PageProps) @{
	<div style="display: contents">
		<DocsHeader pathname={url.pathname} />
		<DocsSidebar pathname={url.pathname} />
		<main class="pt-32 pl-0 pr-0 md:pl-48 lg:pl-64 xl:pr-64" onIdle={(event) => watchHeadings(event.target as HTMLElement)}>
			<div class="m-auto max-w-3xl px-6 pb-24 text-gray-800 antialiased markdown" listen-for-intersection-of-titles="">
				<h1>x-for</h1>
				<p>
					Alpine&#39;s{" "}<code>x-for</code>{" "}directive allows you to create DOM elements by iterating through a list. Here&#39;s a simple example of using it to create a list of colors based on an array.
				</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ colors: ["}</span><span style="color: #032F62;">{"'Red'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #032F62;">{"'Orange'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #032F62;">{"'Yellow'"}</span><span style="color: #24292E;">{"] }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" colors"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        <"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<ul x-data=\"{ colors: ['Red', 'Orange', 'Yellow'] }\">\n    <template x-for=\"color in colors\">\n        <li x-text=\"color\"></li>\n    </template>\n</ul>"}</div></code></pre>
				<Demo0 />
				<p>You may also pass objects to{" "}<code>x-for</code>.</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ car: { make: "}</span><span style="color: #032F62;">{"'Jeep'"}</span><span style="color: #24292E;">{", model: "}</span><span style="color: #032F62;">{"'Grand Cherokee'"}</span><span style="color: #24292E;">{", color: "}</span><span style="color: #032F62;">{"'Black'"}</span><span style="color: #24292E;">{" } }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"(value, index) "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" car"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        <"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"            <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"index"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">: <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"value"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        </"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<ul x-data=\"{ car: { make: 'Jeep', model: 'Grand Cherokee', color: 'Black' } }\">\n    <template x-for=\"(value, index) in car\">\n        <li>\n            <span x-text=\"index\"></span>: <span x-text=\"value\"></span>\n        </li>\n    </template>\n</ul>"}</div></code></pre>
				<Demo1 />
				<p>There are two rules worth noting about{" "}<code>x-for</code>:</p>
				<blockquote>
					<p>
						<code>x-for</code>{" "}MUST be declared on a{" "}<code>&lt;template&gt;</code>{" "}element. That{" "}<code>&lt;template&gt;</code>{" "}element MUST contain only one root element
					</p>
				</blockquote>
				<h2 id="keys"><a href="#keys">Keys</a></h2>
				<p>
					It is important to specify unique keys for each{" "}<code>x-for</code>{" "}iteration if you are going to be re-ordering items. Without dynamic keys, Alpine may have a hard time keeping track of what re-orders and will cause odd side-effects.
				</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ colors: ["}</span></div><div class="line"><span style="color: #24292E;">{"    { id: "}</span><span style="color: #005CC5;">{"1"}</span><span style="color: #24292E;">{", label: "}</span><span style="color: #032F62;">{"'Red'"}</span><span style="color: #24292E;">{" },"}</span></div><div class="line"><span style="color: #24292E;">{"    { id: "}</span><span style="color: #005CC5;">{"2"}</span><span style="color: #24292E;">{", label: "}</span><span style="color: #032F62;">{"'Orange'"}</span><span style="color: #24292E;">{" },"}</span></div><div class="line"><span style="color: #24292E;">{"    { id: "}</span><span style="color: #005CC5;">{"3"}</span><span style="color: #24292E;">{", label: "}</span><span style="color: #032F62;">{"'Yellow'"}</span><span style="color: #24292E;">{" },"}</span></div><div class="line"><span style="color: #24292E;">{"]}"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" colors"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" :"}</span><span style="color: #6F42C1;">{"key"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color.id"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        <"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color.label"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<ul x-data=\"{ colors: [\n    { id: 1, label: 'Red' },\n    { id: 2, label: 'Orange' },\n    { id: 3, label: 'Yellow' },\n]}\">\n    <template x-for=\"color in colors\" :key=\"color.id\">\n        <li x-text=\"color.label\"></li>\n    </template>\n</ul>"}</div></code></pre>
				<p>
					Now if the colors are added, removed, re-ordered, or their "id"s change, Alpine will preserve or destroy the iterated{" "}<code>&lt;li&gt;</code>elements accordingly.
				</p>
				<h2 id="accessing-indexes"><a href="#accessing-indexes">Accessing indexes</a></h2>
				<p>If you need to access the index of each item in the iteration, you can do so using the{" "}<code>([item], [index]) in [items]</code>{" "}syntax like so:</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-data"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"{ colors: ["}</span><span style="color: #032F62;">{"'Red'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #032F62;">{"'Orange'"}</span><span style="color: #24292E;">{", "}</span><span style="color: #032F62;">{"'Yellow'"}</span><span style="color: #24292E;">{"] }"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"(color, index) "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" colors"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        <"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"            <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"index "}</span><span style="color: #D73A49;">{"+"}</span><span style="color: #24292E;">{" "}</span><span style="color: #032F62;">{"': '\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"            <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        </"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<ul x-data=\"{ colors: ['Red', 'Orange', 'Yellow'] }\">\n    <template x-for=\"(color, index) in colors\">\n        <li>\n            <span x-text=\"index + ': '\"></span>\n            <span x-text=\"color\"></span>\n        </li>\n    </template>\n</ul>"}</div></code></pre>
				<p>You can also access the index inside a dynamic{" "}<code>:key</code>{" "}expression.</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"(color, index) "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" colors"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{" :"}</span><span style="color: #6F42C1;">{"key"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"index"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<template x-for=\"(color, index) in colors\" :key=\"index\">"}</div></code></pre>
				<h2 id="iterating-over-a-range"><a href="#iterating-over-a-range">Iterating over a range</a></h2>
				<p>If you need to simply loop{" "}<code>n</code>{" "}number of times, rather than iterate through an array, Alpine offers a short syntax.</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"i "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" "}</span><span style="color: #005CC5;">{"10"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"        <"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"i"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"></"}</span><span style="color: #22863A;">{"li"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    </"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"ul"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<ul>\n    <template x-for=\"i in 10\">\n        <li x-text=\"i\"></li>\n    </template>\n</ul>"}</div></code></pre>
				<p><code>i</code>{" "}in this case can be named anything you like.</p>
				<blockquote>
					<p>
						Despite not being included in the above snippet,{" "}<code>x-for</code>{" "}cannot be used if no parent element has{" "}<code>x-data</code>{" "}defined.{" "}<a href="/directives/data">→ Read more about{" "}<code>x-data</code></a>
					</p>
				</blockquote>
				<h2 id="contents-of-a-template"><a href="#contents-of-a-template">Contents of a{" "}<code>&lt;template&gt;</code></a></h2>
				<p>As mentioned above, an{" "}<code>&lt;template&gt;</code>{" "}tag must contain only one root element.</p>
				<p>For example, the following code will not work:</p>
				<pre><code data-theme="github-light" data-lang="alpine" class="torchlight" style="background-color: #fff; --theme-selection-background: #e2e5e9;"><div class="line"><span style="color: #24292E;">{"<"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-for"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color "}</span><span style="color: #D73A49;">{"in"}</span><span style="color: #24292E;">{" colors"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"    <"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{">The next color is </"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{"><"}</span><span style="color: #22863A;">{"span"}</span><span style="color: #24292E;">{" "}</span><span style="color: #6F42C1;">{"x-text"}</span><span style="color: #24292E;">{"="}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{"color"}</span><span style="color: #032F62;">{"\""}</span><span style="color: #24292E;">{">"}</span></div><div class="line"><span style="color: #24292E;">{"</"}</span><span style="color: #22863A;">{"template"}</span><span style="color: #24292E;">{">"}</span></div><div aria-hidden="true" hidden tabindex="-1" style="display: none;" class="torchlight-copy-target">{"\n<template x-for=\"color in colors\">\n    <span>The next color is </span><span x-text=\"color\">\n</template>"}</div></code></pre>
				<p>but this code will work:</p>
