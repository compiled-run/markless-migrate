// Generated by importer/run.ts from content/; edit the importer or the content, not this file.
import { computed, element, state } from '@markless/core';
import { attr, text } from '../components/alpine/bind.ts';
import { modelValue, syncModel } from '../components/alpine/model.ts';

export function Demo0() @{
	let slide = state(1);
	const value0 = computed(() => attr("src", '/img/morphs/morph'+slide+'.png'));

		<div class="border rounded">
			<div>
				<img src={value0} />
			</div>
			<div class="flex w-full justify-between" style="padding-bottom: 1rem">
				<div class="w-1/2 px-4">
					<button class="w-full bg-cyan-400 rounded-full text-center py-3 font-bold text-white" onClick={(event) => {
						slide = (slide === 1) ? 13 : slide - 1;
					}}>
						Previous
					</button>
				</div>
				<div class="w-1/2 px-4">
					<button class="w-full bg-cyan-400 rounded-full text-center py-3 font-bold text-white" onClick={(event) => {
						slide = (slide % 13) + 1;
					}}>
						Next
					</button>
				</div>
			</div>
		</div>
}

export function Demo1() @{
	let morphed = state(false);
	let message = state('Change me, then press the button!');
	const el0 = element<HTMLElement>();
	const value1 = computed(() => text(message));

		<div class="demo">
			<div id="morph-demo-1" class="space-y-2">
				@if (morphed) {
					<h4>
						See how new elements have been added
					</h4>;
				}
				<input type="text" class="w-full" value="Change me, then press the button!" el={el0} onInput={(event) => {
					message = modelValue(el0!, [], event, message) as typeof message;
				}} />
				<span>{value1}</span>
				@if (morphed) {
					<h4>
						but the state of this component hasn&#39;t changed? Magical.
					</h4>;
				}
			</div>
			<button id="morph-button-1" class="mt-4" onClick={(event) => {
				morphed = true;
			}}>
				Run Morph
			</button>
		</div>
}
