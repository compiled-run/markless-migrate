export function Demo12() @{
	let search = state('');
	const el0 = element<HTMLElement>();
	const value1 = computed(() => text(search));

		<div class="demo">
			<div>
				<input type="text" placeholder="Press Enter or click away" el={el0} onBlur={(event) => {
					search = modelValue(el0!, ["blur","enter"], event, search) as typeof search;
				}} onKeyDown={(event) => {
					if (!((event as KeyboardEvent).key === 'Enter')) return;
search = modelValue(el0!, ["blur","enter"], event, search) as typeof search;
				}} />
				<div class="pt-4">
					Search:{" "}
					<span>{value1}</span>
				</div>
			</div>
		</div>
}

