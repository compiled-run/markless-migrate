import { computed, element, state } from '@markless/core';
import { text } from '../components/alpine/bind.ts';
import { show } from '../components/alpine/show.ts';
import { listen, setup } from '../components/alpine/on.ts';
import { modelValue, syncModel } from '../components/alpine/model.ts';

export function Demo1() @{
	let count = state(0);
	const value0 = computed(() => text(count));

		<div class="demo">
			<div>
				<button onClick={(event) => {
					count++;
				}}>
					Increment
				</button>
				{" "}
				<span>{value0}</span>
			</div>
		</div>
}

export function Demo2() @{
	let open = state(false);
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();

		<div onPointerOver={() => setup(el1, () => {
				listen(el0, "click", ["outside"], (event) => {
					open = false;
					show(el0, open);
				});
			})} onFocusIn={() => setup(el1, () => {
				listen(el0, "click", ["outside"], (event) => {
					open = false;
					show(el0, open);
				});
			})} onTouchStart={() => setup(el1, () => {
				listen(el0, "click", ["outside"], (event) => {
					open = false;
					show(el0, open);
				});
			})} class="demo" el={el1}>
			<div>
				<button onClick={(event) => {
					open = ! open;
					show(el0, open);
				}}>
					Toggle
				</button>
				<div style="display: none;" el={el0}>
					Contents...
				</div>
			</div>
		</div>
}

export function Demo3() @{
	let search = state('');
	let items = state(['foo', 'bar', 'baz']);
	const filteredItems = computed(() => {
		return items.filter(
		i => i.startsWith(search)
		)
	});
	const el0 = element<HTMLElement>();

		<div class="demo">
			<div>
				<input placeholder="Search..." el={el0} onInput={(event) => {
					search = modelValue(el0!, [], event, search) as typeof search;
				}} />
				<ul class="pl-6 pt-2">
					<template></template>
					@for (const row1 of filteredItems; key row1) {
						<li>{row1}</li>
					}
				</ul>
			</div>
		</div>
}
