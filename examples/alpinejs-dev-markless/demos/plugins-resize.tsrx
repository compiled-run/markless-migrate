// Generated by importer/run.ts from content/; edit the importer or the content, not this file.
import { computed, element, state } from '@markless/core';
import { resize } from '../components/alpine/observe.ts';
import { text } from '../components/alpine/bind.ts';

export function Demo0() @{
	let width = state(0);
	let height = state(0);
	const el0 = element<HTMLElement>();
	const value1 = computed(() => text('Width: ' + width + 'px'));
	const value2 = computed(() => text('Height: ' + height + 'px'));
	const el3 = element<HTMLElement>();

		<div onIdle={() => {
			resize(el0, [], (width, height) => {
				width = width; height = height;
			});
		}} class="demo" el={el3}>
			<div el={el0}>
				<i>
					Resize your browser window to see the width and height values change.
				</i>
				{" "}
				<br />
				<br />
				<p>{value1}</p>
				<p>{value2}</p>
			</div>
		</div>
}

export function Demo1() @{
	let width = state(0);
