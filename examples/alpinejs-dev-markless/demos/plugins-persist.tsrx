// Generated by importer/run.ts from content/; edit the importer or the content, not this file.
import { computed, element, state } from '@markless/core';
import { persist, persisted } from '../components/alpine/persist.ts';
import { text } from '../components/alpine/bind.ts';

export function Demo0() @{
	let count = state(0);
	const value0 = computed(() => text(count));
	const el1 = element<HTMLElement>();

		<div onIdle={() => {
			count = persisted("_x_count", count);
		}} class="demo" el={el1}>
			<div>
				<button onClick={(event) => {
					count++;
					persist("_x_count", count);
				}}>
					Increment
				</button>
				{" "}
				<span>{value0}</span>
			</div>
		</div>
}

