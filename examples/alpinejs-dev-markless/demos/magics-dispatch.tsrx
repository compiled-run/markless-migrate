// Generated by importer/run.ts from content/; edit the importer or the content, not this file.
import { element, state } from '@markless/core';
import { dispatch, listen } from '../components/alpine/on.ts';

export function Demo0() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();
	const el2 = element<HTMLElement>();

		<div onIdle={() => {
			listen(el0, "notify", [], (event) => {
				alert('Hello World!');
			});
		}} class="demo" el={el2}>
			<div el={el0}>
				<button el={el1} onClick={(event) => {
					dispatch(el1, 'notify');
				}}>
					Notify
				</button>
			</div>
		</div>
}

export function Demo1() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();
	const el2 = element<HTMLElement>();

		<div onIdle={() => {
			listen(el0, "notify", [], (event) => {
				alert(event.detail.message);
			});
		}} class="demo" el={el2}>
			<div el={el0}>
				<button el={el1} onClick={(event) => {
					dispatch(el1, 'notify', { message: 'Hello World!' });
				}}>
					Notify
				</button>
			</div>
		</div>
}
