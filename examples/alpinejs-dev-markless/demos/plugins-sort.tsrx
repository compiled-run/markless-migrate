export function Demo0() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();
	const el2 = element<HTMLElement>();
	const el3 = element<HTMLElement>();
	const el4 = element<HTMLElement>();

		<div onPointerOver={() => setup(el4, () => {
				sort(el3, { ghost: false, items: [[el0, undefined], [el1, undefined], [el2, undefined]], handles: [] });
			})} onFocusIn={() => setup(el4, () => {
				sort(el3, { ghost: false, items: [[el0, undefined], [el1, undefined], [el2, undefined]], handles: [] });
			})} onTouchStart={() => setup(el4, () => {
				sort(el3, { ghost: false, items: [[el0, undefined], [el1, undefined], [el2, undefined]], handles: [] });
			})} el={el4}>
			<ul el={el3}>
				<li class="cursor-pointer" el={el0}>
					foo
				</li>
				<li class="cursor-pointer" el={el1}>
					bar
				</li>
				<li class="cursor-pointer" el={el2}>
					baz
				</li>
			</ul>
		</div>
}

