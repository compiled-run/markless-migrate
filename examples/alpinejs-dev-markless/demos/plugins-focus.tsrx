export function Demo6() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();
	const el2 = element<HTMLElement>();

		<div class="demo">
			<button el={el0} onClick={(event) => {
				focusMagic(el0).within(el1).first();
			}}>
				Focus "First"
			</button>
			{" "}
			<button el={el2} onClick={(event) => {
				focusMagic(el2).within(el1).last();
			}}>
				Focus "Last"
			</button>
			<hr class="mt-2 mb-2" />
			<div el={el1} onKeyDown={(event) => {
((event: Event) => {
	if (!passes(event, el1, ["right"])) return;
focusMagic(el1).wrap().next();
})(event);
((event: Event) => {
	if (!passes(event, el1, ["left"])) return;
focusMagic(el1).wrap().previous();
})(event);
}}>
				<button class="focus:outline-none focus:ring-2 focus:ring-cyan-400">First</button>
				{" "}
				<button class="focus:outline-none focus:ring-2 focus:ring-cyan-400">Second</button>
