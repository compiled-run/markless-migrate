// Generated by importer/run.ts from content/; edit the importer or the content, not this file.
import { element, state } from '@markless/core';
import { mask } from '../components/alpine/mask.ts';

export function Demo0() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();

		<div onIdle={() => {
			mask(el0 as HTMLInputElement, (input, money) => "99/99/9999");
		}} class="demo" el={el1}>
			<input placeholder="MM/DD/YYYY" el={el0} />
		</div>
}

export function Demo1() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();

		<div onIdle={() => {
			mask(el0 as HTMLInputElement, (input, money) => input.startsWith('34') || input.startsWith('37')
            ? '9999 999999 99999' : '9999 9999 9999 9999');
		}} class="demo" el={el1}>
			<input el={el0} />
		</div>
}

export function Demo2() @{
	const el0 = element<HTMLElement>();
	const el1 = element<HTMLElement>();

		<div onIdle={() => {
			mask(el0 as HTMLInputElement, (input, money) => money(input));
		}} class="demo" el={el1}>
			<input type="text" placeholder="0.00" el={el0} />
		</div>
}

