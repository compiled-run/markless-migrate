			{" "}
			<h5 id="example-4"><a class="zola-anchor" href="#example-4" aria-label="Anchor link for: example-4">Example</a></h5>
			{" "}
			<pre data-lang="js" style="background-color:#1f2329;color:#abb2bf;" class="language-js "><code class="language-js" data-lang="js"><span>{"  "}</span><span style="font-style:italic;color:#848da1;">{"// override SSE event sources to not use credentials\n"}</span><span>{"  "}</span><span style="color:#e06c75;">htmx</span><span>.</span><span style="color:#61afef;">{"createEventSource "}</span><span>{"= "}</span><span style="color:#c678dd;">function</span><span>(</span><span style="color:#e06c75;">url</span><span>{") {\n"}</span><span>{"    "}</span><span style="color:#c678dd;">{"return "}</span><span>new EventSource(</span><span style="color:#e06c75;">url</span><span>, &#123;withCredentials:</span><span style="color:#d19a66;">false</span><span>{"});\n"}</span><span>{"  };\n"}</span></code></pre>
			{" "}
			<h3 id="createWebSocket"><a class="zola-anchor" href="#createWebSocket" aria-label="Anchor link for: createWebSocket">{"Property - "}<code>htmx.createWebSocket</code></a></h3>
			{" "}
			<p>{"A property used to create new "}<a rel="noopener" target="_blank" href="https://github.com/bigskysoftware/htmx-extensions/blob/main/src/ws/README.md">WebSocket</a>. This can be updated to provide custom WebSocket setup.</p>
