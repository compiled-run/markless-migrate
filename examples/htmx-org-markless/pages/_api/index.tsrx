			{" "}
			<pre data-lang="js" style="background-color:#1f2329;color:#abb2bf;" class="language-js "><code class="language-js" data-lang="js"><span>{"  "}</span><span style="font-style:italic;color:#848da1;">{"// defines a silly extension that just logs the name of all events triggered\n"}</span><span>{"  "}</span><span style="color:#e06c75;">htmx</span><span>.</span><span style="color:#61afef;">defineExtension</span><span>(</span><span style="color:#98c379;">"silly"</span><span>{", {\n"}</span><span>{"    "}</span><span style="color:#61afef;">{"onEvent "}</span><span>{": "}</span><span style="color:#c678dd;">function</span><span>(</span><span style="color:#e06c75;">name</span><span>{", "}</span><span style="color:#e06c75;">evt</span><span>{") {\n"}</span><span>{"      "}</span><span style="color:#e5c07b;">console</span><span>.</span><span style="color:#56b6c2;">log</span><span>(</span><span style="color:#98c379;">{"\"Event \" "}</span><span>{"+ "}</span><span style="color:#e06c75;">{"name "}</span><span>{"+ "}</span><span style="color:#98c379;">" was triggered!"</span><span>{")\n"}</span><span>{"    }\n"}</span><span>{"  });\n"}</span></code></pre>
			{" "}
			<h3 id="find"><a class="zola-anchor" href="#find" aria-label="Anchor link for: find">{"Method - "}<code>htmx.find()</code></a></h3>
			{" "}
			<p>Finds an element matching the selector</p>
