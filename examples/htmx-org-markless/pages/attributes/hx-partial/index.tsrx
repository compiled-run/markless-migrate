export default function Page() @{
	<div style="display: contents">
		<SiteHeader />
		<main class="c content ">
			<h1><code>hx-partial</code></h1>
			{" "}
			<p><code>&lt;hx-partial&gt;</code>{" is a "}<strong>server-sent swap command</strong>{", not a DOM element. It exists only in the HTTP response body. The server wraps content in "}<code>&lt;hx-partial hx-target="..."&gt;</code>{" tags to tell htmx where to swap that content; htmx reads the instructions, performs the swap, and discards the envelope entirely — nothing from the "}<code>&lt;hx-partial&gt;</code>{" tag itself ever appears in the page."}</p>
			{" "}
			<p>{"This is similar to "}<a href="https://htmx.org/attributes/hx-swap-oob/"><code>hx-swap-oob</code></a>{" but with key differences: the envelope is always consumed and discarded, targets are resolved relative to the "}<strong>triggering element</strong>{" using the full htmx extended selector vocabulary, and partials execute "}<strong>before</strong>{" the main swap."}</p>
			{" "}
			<h2 id="basic-usage">Basic usage</h2>
			{" "}
			<p>{"A response can contain any number of "}<code>&lt;hx-partial&gt;</code>{" elements alongside (or instead of) the main response content:"}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">div</span><span>&gt;Updated main content&lt;/</span><span style="color:#e06c75;">div</span><span>{">\n"}</span><span>{"\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#notifications"</span><span>{">\n"}</span><span>{"  3 new messages\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span><span>{"\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">{"\"#user-status\" "}</span><span style="color:#d19a66;">hx-swap</span><span>=</span><span style="color:#98c379;">"outerHTML"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">{"span "}</span><span style="color:#d19a66;">id</span><span>=</span><span style="color:#98c379;">{"\"user-status\" "}</span><span style="color:#d19a66;">class</span><span>=</span><span style="color:#98c379;">"online"</span><span>&gt;Online&lt;/</span><span style="color:#e06c75;">span</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<p>{"The first "}<code>&lt;hx-partial&gt;</code>{" replaces the "}<code>innerHTML</code>{" of "}<code>#notifications</code>{". The second replaces the entire "}<code>#user-status</code>{" element using "}<code>outerHTML</code>{". The "}<code>&lt;div&gt;</code>{" is swapped into the main request target as normal."}</p>
			{" "}
			<h2 id="id-shorthand">id shorthand</h2>
			{" "}
			<p>{"If you give the "}<code>&lt;hx-partial&gt;</code>{" an "}<code>id</code>{" attribute and omit "}<code>hx-target</code>{", htmx uses "}<code>#&lt;id&gt;</code>{" as the target selector:"}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">id</span><span>=</span><span style="color:#98c379;">"alerts"</span><span>{">\n"}</span><span>{"  Saved successfully!\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<p>{"This is equivalent to "}<code>&lt;hx-partial hx-target="#alerts"&gt;</code>.</p>
			{" "}
			<h2 id="controlling-the-swap-style">Controlling the swap style</h2>
			{" "}
			<p>{"The "}<code>hx-swap</code>{" attribute on "}<code>&lt;hx-partial&gt;</code>{" accepts all the same values as "}<a href="https://htmx.org/attributes/hx-swap/"><code>hx-swap</code></a>{" on a normal element. The default is "}<code>innerHTML</code>.</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">{"\"#feed\" "}</span><span style="color:#d19a66;">hx-swap</span><span>=</span><span style="color:#98c379;">"beforeend"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">li</span><span>&gt;New item&lt;/</span><span style="color:#e06c75;">li</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<h2 id="extended-selectors">Extended selectors</h2>
			{" "}
			<p><code>hx-target</code>{" on a partial is resolved relative to the "}<strong>triggering element</strong>, so you can use the full htmx extended selector vocabulary:</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"closest tr"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">td</span><span>&gt;Updated&lt;/</span><span style="color:#e06c75;">td</span><span>&gt;&lt;</span><span style="color:#e06c75;">td</span><span>&gt;values&lt;/</span><span style="color:#e06c75;">td</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span><span>{"\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"find .status"</span><span>{">\n"}</span><span>{"  Active\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<p>{"See "}<a href="https://htmx.org/attributes/hx-target/"><code>hx-target</code></a>{" for the full list of extended selectors ("}<code>closest</code>{", "}<code>find</code>{", "}<code>next</code>{", "}<code>previous</code>, etc.).</p>
			{" "}
			<h2 id="multiple-partials">Multiple partials</h2>
			{" "}
			<p>{"Any number of "}<code>&lt;hx-partial&gt;</code>{" elements may appear in a single response. They are processed in document order, all before the main swap."}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#cart-count"</span><span>&gt;2&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#cart-total"</span><span>&gt;$19.98&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">{"\"#last-added\" "}</span><span style="color:#d19a66;">hx-swap</span><span>=</span><span style="color:#98c379;">"afterbegin"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">li</span><span>&gt;Widget&lt;/</span><span style="color:#e06c75;">li</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<h2 id="partials-only-response">Partials-only response</h2>
			{" "}
			<p>{"If the response contains "}<strong>only</strong>{" "}<code>&lt;hx-partial&gt;</code>{" elements (no other content), the main swap is suppressed and the original target is left unchanged. This lets the server update arbitrary parts of the page without touching the element that triggered the request."}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span style="font-style:italic;color:#848da1;">{"<!-- entire response — main target is not modified -->\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#status"</span><span>&gt;Done&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#count"</span><span>&gt;42&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<h2 id="template-fallback-form">Template fallback form</h2>
			{" "}
			<p>{"If a partial response is accidentally rendered as a full page — for example during development or due to a server misconfiguration — raw "}<code>&lt;hx-partial&gt;</code>{" tags will appear as visible text in the browser. The "}<code>&lt;template hx type="partial"&gt;</code>{" form avoids this: browsers treat "}<code>&lt;template&gt;</code>{" as inert and render nothing, so the page stays blank rather than leaking raw swap commands."}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"template "}</span><span style="color:#d19a66;">hx type</span><span>=</span><span style="color:#98c379;">{"\"partial\" "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">"#alerts"</span><span>{">\n"}</span><span>{"  Saved!\n"}</span><span>&lt;/</span><span style="color:#e06c75;">template</span><span>{">\n"}</span></code></pre>
			{" "}
			<p>Both forms behave identically when processed by htmx.</p>
			{" "}
			<h2 id="troublesome-tables-and-lists">Troublesome tables and lists</h2>
			{" "}
			<p>{"Before the response is parsed, htmx converts "}<code>&lt;hx-partial&gt;</code>{" tags into "}<code>&lt;template&gt;</code>{" elements. Because the content lives inside "}<code>template.content</code>{", it is parsed in a fragment context and survives intact — "}<code>&lt;tr&gt;</code>{", "}<code>&lt;td&gt;</code>{", "}<code>&lt;li&gt;</code>{" and similar elements are preserved regardless of where the "}<code>&lt;hx-partial&gt;</code>{" appears in the response."}</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"hx-partial "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">{"\"#row-3\" "}</span><span style="color:#d19a66;">hx-swap</span><span>=</span><span style="color:#98c379;">"outerHTML"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">{"tr "}</span><span style="color:#d19a66;">id</span><span>=</span><span style="color:#98c379;">"row-3"</span><span>&gt;&lt;</span><span style="color:#e06c75;">td</span><span>&gt;Updated&lt;/</span><span style="color:#e06c75;">td</span><span>&gt;&lt;/</span><span style="color:#e06c75;">tr</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">hx-partial</span><span>{">\n"}</span></code></pre>
			{" "}
			<p>If your template engine requires strictly valid HTML and rejects unknown tags, use the template fallback form with the appropriate wrapper so the parser sees valid content:</p>
			{" "}
			<pre data-lang="html" style="background-color:#1f2329;color:#abb2bf;" class="language-html "><code class="language-html" data-lang="html"><span>&lt;</span><span style="color:#e06c75;">{"template "}</span><span style="color:#d19a66;">hx type</span><span>=</span><span style="color:#98c379;">{"\"partial\" "}</span><span style="color:#d19a66;">hx-target</span><span>=</span><span style="color:#98c379;">{"\"find tbody\" "}</span><span style="color:#d19a66;">hx-swap</span><span>=</span><span style="color:#98c379;">"beforeend"</span><span>{">\n"}</span><span>{"  <"}</span><span style="color:#e06c75;">table</span><span>&gt;&lt;</span><span style="color:#e06c75;">tbody</span><span>&gt;&lt;</span><span style="color:#e06c75;">tr</span><span>&gt;&lt;</span><span style="color:#e06c75;">td</span><span>&gt;New row&lt;/</span><span style="color:#e06c75;">td</span><span>&gt;&lt;/</span><span style="color:#e06c75;">tr</span><span>&gt;&lt;/</span><span style="color:#e06c75;">tbody</span><span>&gt;&lt;/</span><span style="color:#e06c75;">table</span><span>{">\n"}</span><span>&lt;/</span><span style="color:#e06c75;">template</span><span>{">\n"}</span></code></pre>
			{" "}
			<h2 id="comparison-with-hx-swap-oob">Comparison with hx-swap-oob</h2>
			{" "}
			<table><thead><tr><th></th><th><code>hx-swap-oob</code></th><th><code>&lt;hx-partial&gt;</code></th></tr></thead><tbody>{" "}<tr><td>Placed on</td><td>the content element itself</td><td>a wrapper element (always stripped)</td></tr>{" "}<tr><td>Target resolution</td><td>{"by "}<code>id</code>{" match or CSS selector"}</td><td>htmx extended selectors, relative to triggering element</td></tr>{" "}<tr><td>Execution order</td><td>before main swap</td><td>before main swap</td></tr>{" "}<tr><td>Template engine safe form</td><td><code>&lt;template&gt;</code>{" wrapper"}</td><td><code>&lt;template hx type="partial"&gt;</code></td></tr>{" "}<tr><td>Cancellable via event</td><td><code>htmx:oobBeforeSwap</code></td><td><code>htmx:partialBeforeSwap</code></td></tr>{" "}</tbody></table>
			{" "}
			<h2 id="events">Events</h2>
			{" "}
			<ul>{" "}<li><a href="https://htmx.org/events/#htmx:partialBeforeSwap"><code>htmx:partialBeforeSwap</code></a>{" — fired before each partial swap; cancellable, allows re-targeting and fragment rewriting"}</li>{" "}<li><a href="https://htmx.org/events/#htmx:partialAfterSwap"><code>htmx:partialAfterSwap</code></a>{" — fired after each partial swap"}</li>{" "}<li><a href="https://htmx.org/events/#htmx:partialErrorNoTarget"><code>htmx:partialErrorNoTarget</code></a>{" — fired on "}<code>document.body</code>{" when no element matches the target selector"}</li>{" "}<li><a href="https://htmx.org/events/#htmx:processTemplate"><code>htmx:processTemplate</code></a>{" — fired for any other "}<code>&lt;hx-*&gt;</code>{" tag type (e.g. "}<code>&lt;hx-toast&gt;</code>), allowing custom handling</li>{" "}</ul>
			{" "}
			<h2 id="notes">Notes</h2>
			{" "}
