{
	"name": "vite-dev-markless",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "rm -rf public/page-scripts public/assets && vp build -c page-scripts.config.ts && NODE_OPTIONS=--max-old-space-size=12288 vp build",
		"preview": "vp preview",
		"check": "vp check",
		"doctor": "node scripts/markless-doctor.mjs",
		"fmt": "vp fmt",
		"test": "vp test",
		"import-docs": "DEPLOY_PRIME_URL=https://vite.dev COMMIT_REF=b6c20f6a node scripts/import-docs.ts"
	},
	"dependencies": {
		"@markless/core": "file:./.markless-local/markless-core-0.9.0.tgz",
		"@markless/router": "file:./.markless-local/markless-router-0.9.0.tgz",
		"@rive-app/canvas-lite": "2.35.1",
		"focus-trap": "8.2.2",
		"mark.js": "8.11.1",
		"minisearch": "7.2.0",
		"nitro": "3.0.260429-beta",
		"vite-plus": "0.3.1"
	},
	"devDependencies": {
		"@markless/analyzer": "file:./.markless-local/markless-analyzer-0.9.0.tgz",
		"@markless/typescript-plugin": "file:./.markless-local/markless-typescript-plugin-0.9.0.tgz",
		"parse5": "^7.3.0",
		"typescript": "^5.9.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
	},
	"overrides": {
		"vite": "$vite",
		"@markless/analyzer": "file:./.markless-local/markless-analyzer-0.9.0.tgz",
		"@markless/bundler": "file:./.markless-local/markless-bundler-0.9.0.tgz",
		"@markless/compiler": "file:./.markless-local/markless-compiler-0.9.0.tgz",
		"@markless/core": "file:./.markless-local/markless-core-0.9.0.tgz",
		"@markless/router": "file:./.markless-local/markless-router-0.9.0.tgz",
		"@markless/runtime": "file:./.markless-local/markless-runtime-0.9.0.tgz",
		"@markless/serializer": "file:./.markless-local/markless-serializer-0.9.0.tgz",
		"@markless/typescript-plugin": "file:./.markless-local/markless-typescript-plugin-0.9.0.tgz",
