v-75c067b6=""><p class="text" data-v-75c067b6="">Migration from v7</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/changes/" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Breaking Changes</p></a></div></div></div></section></div><div class="no-transition group" data-v-f767aff1=""><section class="VPSidebarItem level-0" data-v-f767aff1="" data-v-75c067b6=""><div class="item" role="button" tabindex="0" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><h2 class="text" data-v-75c067b6="">APIs</h2></div><div class="items" data-v-75c067b6=""><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-plugin" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Plugin API</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-hmr" data-v-75c067b6=""><p class="text" data-v-75c067b6="">HMR API</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-javascript" data-v-75c067b6=""><p class="text" data-v-75c067b6="">JavaScript API</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/config/" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Config Reference</p></a></div></div></div></section></div><div class="no-transition group" data-v-f767aff1=""><section class="VPSidebarItem level-0" data-v-f767aff1="" data-v-75c067b6=""><div class="item" role="button" tabindex="0" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><h2 class="text" data-v-75c067b6="">Environment API</h2></div><div class="items" data-v-75c067b6=""><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-environment" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Introduction</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-environment-instances" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Environment Instances</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-environment-plugins" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Plugins</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-environment-frameworks" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Frameworks</p></a></div></div><div class="VPSidebarItem level-1 is-link" data-v-75c067b6=""><div class="item" data-v-75c067b6=""><div class="indicator" data-v-75c067b6=""></div><a class="VPLink link link" href="/guide/api-environment-runtimes" data-v-75c067b6=""><p class="text" data-v-75c067b6="">Runtimes</p></a></div></div></div></section></div></nav></aside><div class="VPContent has-sidebar" id="VPContent" data-v-2ea92cbb="" data-v-2eb020da=""><div class="VPDoc has-sidebar has-aside" data-v-2eb020da="" data-v-94d54df8=""><div class="container" data-v-94d54df8=""><div class="aside" data-v-94d54df8=""><div cla