-right mt-auto"><div data-v-5773249e="" class="space-y-6"><div data-v-5773249e="" class="px-4"><button data-v-5773249e="" class="w-full flex items-center justify-between text-grey dark:text-white/80 text-sm font-medium" data-toggle="language" aria-expanded="false"><span data-v-5773249e="">Language</span><svg data-v-5773249e="" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" role="img" width="1em" height="1em" viewBox="0 0 24 24" class="iconify iconify--lucide size-4 transition-transform duration-200"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"></path></svg></button><ul data-v-5773249e="" class="mt-3 space-y-1" style="display: none;"><li data-v-5773249e=""><a data-v-5773249e="" href="https://cn.vite.dev/blog/announcing-vite4-3" class="block py-2 text-sm text-primary dark:text-white hover:opacity-70 transition-opacity">简体中文</a></li><li data-v-5773249e=""><a data-v-5773249e="" href="https://ja.vite.dev/blog/announcing-vite4-3" class="block py-2 text-sm text-primary dark:text-white hover:opacity-70 transition-opacity">日本語</a></li><li data-v-5773249e=""><a data-v-5773249e="" href="https://es.vite.dev/blog/announcing-vite4-3" class="block py-2 text-sm text-primary dark:text-white hover:opacity-70 transition-opacity">Español</a></li><li data-v-5773249e=""><a data-v-5773249e="" href="https://ko.vite.dev/blog/announcing-vite4-3" class="block py-2 text-sm text-primary dark:text-white hover:opacity-70 transition-opacity">한국어</a></li><li data-v-5773249e=""><a data-v-5773249e="" href="https://de.vite.dev/blog/announcing-vite4-3" class="block py-2 text-sm text-primary dark:text-white hover:opacity-70 transition-opacity">Deutsch</a></li></ul></div><div data-v-5773249e="" class="flex items-center justify-between px-4"><span data-v-5773249e="" class="text-grey dark:text-white/80 text-sm font-medium">Appearance</span><button class="VPSwitch VPSwitchAppearance" type="button" role="switch" title="" aria-