{
  "tsrx": {
    "compiler": "@markless/typescript-plugin/volar"
  },
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "types": ["vite/client"],
    "plugins": [
      {
        "name": "@markless/typescript-plugin"
      },
      {
        "name": "@markless/router/typescript-plugin"
      }
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "markless-router-env.d.ts",
    "document.tsrx",
    "pages",
    "components",
    "lib",
    "api",
    "middleware",
    "vite.config.ts"
  ]
}
