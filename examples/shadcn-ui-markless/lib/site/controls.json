	{"selector": "[data-slot=\"preview\"] button", "action": "play", "text": "^Replay$", "routes": "^/docs/ai-elements/[^/]+/(chain-of-thought|plan|queue|reasoning|sources|stack-trace|subagent|task|terminal|test-results|tool)$"},
	{"selector": "[data-slot=\"preview\"] textarea[data-slot=\"input-group-control\"], [data-slot=\"preview\"] button", "action": "play", "text": "^Replay$", "routes": "^/docs/changelog(/2026-10-ai-elements)?$"},
	{"selector": "[data-slot=\"card-footer\"] button", "action": "play", "text": "^Load more content$", "region": "[data-slot=\"card\"]", "settle": 2600, "routes": "^/sera$"},
	{"selector": "[data-slot=\"code-block\"] button[aria-label=\"Download\"]", "action": "download", "routes": "^/docs/(components/[^/]+/code-block|changelog|changelog/2026-10-ai-elements)$"},
	{"selector": "button[data-last-copied]", "action": "notify", "routes": "^/colors$", "template": "copyColor"}
