	{"selector": "[data-slot=\"code-block-copy-button\"]", "action": "copy", "routes": "^/docs/(components/[^/]+/code-block|ai-elements/[^/]+/message|changelog|changelog/2026-10-ai-elements)$"},
	{"selector": "[data-slot=\"preview\"] button[data-slot=\"tooltip-trigger\"][aria-label=\"Copy\"]", "action": "copy", "routes": "^/docs/(components/[^/]+/message|ai-elements/[^/]+/message)$"},
	{"selector": "button[data-slot=\"button\"][aria-label=\"Copy\"]", "action": "copy", "routes": "^/docs/(components/[^/]+/(input-group|message)|ai-elements/[^/]+/message|changelog|changelog/2025-10-new-components|changelog/2026-10-ai-elements)$"},
	{"selector": "[data-slot=\"preview\"] button[data-slot=\"button\"]", "action": "notify", "routes": "^/docs/components/[^/]+/(sonner|toast)$"},
