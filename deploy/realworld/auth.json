{
	"note": "Starter written by plan from the auth guards in the source. Set each role's credentials in the environment (never in this file), check the login steps against the login page, then pass this file to check --auth. A role can use \"storageState\": \"file.json\" instead of \"login\".",
	"loginRoute": "/login",
	"roles": {
		"signed-in": {
			"login": [
				{
					"goto": "/login"
				},
				{
					"fill": {
						"placeholder": "Email"
					},
					"value": "${SIGNED_IN_EMAIL}"
				},
				{
					"fill": {
						"placeholder": "Password"
					},
					"value": "${SIGNED_IN_PASSWORD}"
				},
				{
					"click": {
						"role": "button",
						"name": "Sign in"
					}
				},
				{
					"wait": "!/login"
				}
			]
		}
	},
	"guards": [
		"/login: signed-in (src/app/app.routes.ts:23)",
		"/register: signed-in (src/app/app.routes.ts:28)",
		"/settings: signed-in (src/app/app.routes.ts:33)",
		"/editor: signed-in (src/app/app.routes.ts:45)",
		"/editor/:slug: signed-in (src/app/app.routes.ts:50)"
	]
}
