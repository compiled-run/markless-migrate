{
	"rewrites": [
		{
			"source": "/query",
			"destination": "https://mm-next-dashboard-new.vercel.app/query"
		},
		{
			"source": "/query/",
			"destination": "https://mm-next-dashboard-new.vercel.app/query/"
		},
		{
			"source": "/_img/:path*",
			"destination": "https://mm-next-dashboard-new.vercel.app/_img/:path*"
		},
		{
			"source": "/assets/:path*",
			"destination": "https://mm-next-dashboard-new.vercel.app/assets/:path*"
		},
		{
			"source": "/build/:path*",
			"destination": "https://mm-next-dashboard-new.vercel.app/build/:path*"
		},
		{
			"source": "/fonts/:path*",
			"destination": "https://mm-next-dashboard-new.vercel.app/fonts/:path*"
		},
		{
			"source": "/",
			"destination": "https://mm-next-dashboard-old.vercel.app/"
		},
		{
			"source": "/:path*/",
			"destination": "https://mm-next-dashboard-old.vercel.app/:path*/"
		},
		{
			"source": "/:path*",
			"destination": "https://mm-next-dashboard-old.vercel.app/:path*"
		}
	]
}
