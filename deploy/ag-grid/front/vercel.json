{
	"rewrites": [
		{
			"source": "/manifest.json",
			"destination": "https://mm-ag-grid-new.vercel.app/manifest.json"
		},
		{
			"source": "/manifest.json/",
			"destination": "https://mm-ag-grid-new.vercel.app/manifest.json/"
		},
		{
			"source": "/.gitkeep",
			"destination": "https://mm-ag-grid-new.vercel.app/.gitkeep"
		},
		{
			"source": "/assets/:path*",
			"destination": "https://mm-ag-grid-new.vercel.app/assets/:path*"
		},
		{
			"source": "/build/:path*",
			"destination": "https://mm-ag-grid-new.vercel.app/build/:path*"
		},
		{
			"source": "/",
			"destination": "https://mm-ag-grid-old.long-wildflower-ecf7.workers.dev/"
		},
		{
			"source": "/:path*/",
			"destination": "https://mm-ag-grid-old.long-wildflower-ecf7.workers.dev/:path*/"
		},
		{
			"source": "/:path*",
			"destination": "https://mm-ag-grid-old.long-wildflower-ecf7.workers.dev/:path*"
		}
	]
}
