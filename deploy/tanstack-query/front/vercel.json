{
	"rewrites": [
		{
			"source": "/_markless/:path*",
			"destination": "https://mm-tanstack-query-new.vercel.app/_markless/:path*"
		},
		{
			"source": "/build/:path*",
			"destination": "https://mm-tanstack-query-new.vercel.app/build/:path*"
		},
		{
			"source": "/",
			"destination": "https://mm-tanstack-query-old.long-wildflower-ecf7.workers.dev/"
		},
		{
			"source": "/:path*/",
			"destination": "https://mm-tanstack-query-old.long-wildflower-ecf7.workers.dev/:path*/"
		},
		{
			"source": "/:path*",
			"destination": "https://mm-tanstack-query-old.long-wildflower-ecf7.workers.dev/:path*"
		}
	]
